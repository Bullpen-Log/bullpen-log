# Supabase 연결 문자열 (앱 런타임용, 커넥션 풀러 포트 6543)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Prisma 마이그레이션용 직접 연결 (포트 5432)
# 풀러(6543)로는 migrate가 멈추므로 반드시 별도로 지정해야 합니다.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# 세션 JWT 서명 키 — 로그인 쿠키에 서명하는 데만 쓴다.
#
# 팀원끼리 같은 값일 필요가 없다. 각자 자기 컴퓨터의 서버하고만 대화하므로
# 아무 값이나 새로 만들어 쓰면 된다. 남에게 받지 말고 직접 만들 것.
#
#   맥/리눅스:  openssl rand -base64 32
#   어디서나:   node -e "console.log(require(\'crypto\').randomBytes(32).toString(\'base64\'))"
SESSION_SECRET="여기에_생성한_키를_넣으세요"

# 이 이메일로 가입하는 계정에 자동으로 관리자(ADMIN) 권한이 부여됩니다.
# 관리자만 트레이닝 영상과 메커니즘 가이드를 등록/삭제할 수 있습니다.
# 팀원이라면 여기에 '자기' 이메일을 넣고 그 이메일로 가입하면 된다.
ADMIN_EMAIL="your@email.com"

# Supabase Storage (투구 영상 업로드용)
SUPABASE_URL="https://프로젝트ID.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="여기에_service_role_키"

# Anthropic API — AI 리포트 생성용
# console.anthropic.com 에서 발급받습니다. 진짜 키는 .env 에만 넣으세요.
# 비워두면 AI 리포트만 안 되고 나머지 기능은 전부 정상으로 돌아간다.
ANTHROPIC_API_KEY="sk-ant-..."
# 선택: 쓰는 모델을 바꾸고 싶을 때. 비워두면 claude-sonnet-5
# AI_MODEL="claude-sonnet-5"
