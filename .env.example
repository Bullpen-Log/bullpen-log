# Supabase 연결 문자열 (앱 런타임용, 커넥션 풀러 포트 6543)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Prisma 마이그레이션용 직접 연결 (포트 5432)
# 풀러(6543)로는 migrate가 멈추므로 반드시 별도로 지정해야 합니다.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# 세션 JWT 서명 키 — 아래 명령으로 생성하세요:
#   openssl rand -base64 32
SESSION_SECRET="여기에_생성한_키를_넣으세요"

# 이 이메일로 가입하는 계정에 자동으로 관리자(ADMIN) 권한이 부여됩니다.
# 관리자만 트레이닝 영상과 메커니즘 가이드를 등록/삭제할 수 있습니다.
ADMIN_EMAIL="your@email.com"
