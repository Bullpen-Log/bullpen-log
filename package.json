{
  "name": "bullpen-log",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "backup": "node --env-file=.env scripts/backup.mjs",
    "restore": "node --env-file=.env scripts/restore.mjs",
    "icons": "node scripts/make-icons.mjs",
    "training:test": "node --env-file=.env --import ./scripts/alias-register.mjs scripts/training-selftest.mts",
    "training:usage": "node --env-file=.env --import ./scripts/alias-register.mjs scripts/training-usage-stats.mts",
    "tabs:timing": "node --env-file=.env scripts/tab-timing.mjs",
    "rpc:timing": "node --env-file=.env scripts/rpc-timing.mjs",
    "training:baseline": "node --env-file=.env --import ./scripts/alias-register.mjs scripts/training-baseline.mts",
    "nutrition:test": "node --import ./scripts/alias-register.mjs scripts/nutrition-selftest.mts",
    "nutrition:reps": "node --env-file=.env scripts/fetch-mfds-reps.mjs",
    "personalize:check": "node --env-file=.env --import ./scripts/alias-register.mjs scripts/personalize-check.mts",
    "equipment:check": "node --env-file=.env --import ./scripts/alias-register.mjs scripts/equipment-check.mts",
    "theme:check": "node --env-file=.env --import ./scripts/alias-register.mjs scripts/theme-time-check.mts",
    "outbox:test": "node --import ./scripts/alias-register.mjs scripts/outbox-selftest.mts",
    "native-outbox:test": "node --import ./scripts/native-test-register.mjs scripts/native-outbox-selftest.mts",
    "native-api:test": "node scripts/native-api-selftest.mts",
    "shared-lib:test": "node scripts/shared-lib-selftest.mts",
    "program:test": "node --import ./scripts/alias-register.mjs scripts/program-selftest.mts",
    "pitch-lab:test": "node --import ./scripts/alias-register.mjs scripts/pitch-lab-selftest.mts",
    "pitch3d:test": "node --import ./scripts/alias-register.mjs scripts/pitch-3d-selftest.mts",
    "highlights:test": "node --import ./scripts/alias-register.mjs scripts/highlights-selftest.mts",
    "pitch-find:test": "node --import ./scripts/alias-register.mjs scripts/pitch-find-selftest.mts",
    "hitting:test": "node --import ./scripts/alias-register.mjs scripts/hitting-log-selftest.mts",
    "pitch-import:test": "node --import ./scripts/alias-register.mjs scripts/pitch-import-selftest.mts",
    "arm-status:test": "node --import ./scripts/alias-register.mjs scripts/arm-status-selftest.mts",
    "calendar:test": "node --import ./scripts/alias-register.mjs scripts/calendar-event-selftest.mts",
    "org:test": "node --import ./scripts/alias-register.mjs scripts/org-selftest.mts",
    "good-days:test": "node --import ./scripts/alias-register.mjs scripts/good-days-selftest.mts",
    "mechanics:test": "node --env-file=.env --import ./scripts/alias-register.mjs scripts/mechanics-selftest.mts",
    "armcare-map:test": "node --env-file=.env --import ./scripts/alias-register.mjs scripts/armcare-map-selftest.mts",
    "velocity:test": "node scripts/velocity-selftest.mts",
    "velocity:engine2-test": "node scripts/velocity-engine2-test.mts",
    "app-update:test": "node --import ./scripts/alias-loader.mjs scripts/app-update-selftest.mts",
    "velocity:queue-test": "node scripts/velocity-engine-queue-test.mts",
    "velocity:detect-test": "node scripts/velocity-detect-test.mts",
    "velocity:video-test": "node scripts/velocity-video-test.mts",
    "velocity:live-test": "node scripts/velocity-live-test.mts",
    "velocity:accuracy": "node scripts/velocity-accuracy.mts",
    "abs:test": "node --import ./scripts/alias-register.mjs scripts/abs-selftest.mts && node scripts/abs-p1-selftest.mts && node scripts/abs-p2-selftest.mts",
    "abs:bench": "node scripts/abs-bench.mts",
    "velocity:review": "node --env-file=.env scripts/velocity-review.mts",
    "rotation:check": "node --env-file=.env --import ./scripts/alias-register.mjs scripts/rotation-check.mts",
    "patch:sync": "node scripts/sync-patch-notes.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "nutrition:advice-test": "node --import ./scripts/alias-register.mjs scripts/nutrition-advice-test.mts",
    "pitch3d:v2-test": "node --import ./scripts/alias-register.mjs scripts/pitch-3d-v2-selftest.mts",
    "integration:test": "node --import ./scripts/alias-register.mjs scripts/integration-selftest.mts",
    "pitch3d:marker-score": "node scripts/pitch-lab/markers/selfcal/score-all.mjs",
    "pitch3d:jitter": "node scripts/pitch-lab/jitter/score.mjs",
    "pitch3d:overlay": "node scripts/pitch-lab/overlay/overlay.mjs",
    "pitch3d:bundle": "node scripts/pitch3d-bundle.mjs --check",
    "shoot:test": "node --import ./scripts/alias-register.mjs scripts/shoot-selftest.mts",
    "clip:test": "node --import ./scripts/alias-register.mjs scripts/clip-selftest.mts",
    "shoot:plan": "node --env-file=.env --import ./scripts/alias-register.mjs scripts/shoot-plan.mts",
    "shoot:refs": "node --env-file=.env --import ./scripts/alias-register.mjs scripts/shoot-refs.mts",
    "shoot:outdoor": "node --env-file=.env --import ./scripts/alias-register.mjs scripts/shoot-plan-outdoor.mts",
    "library:bundle": "node --env-file=.env --import ./scripts/alias-register.mjs scripts/library-bundle.mts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@supabase/supabase-js": "^2.111.0",
    "@zxing/library": "^0.23.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "jose": "^6.2.5",
    "lucide-react": "^1.28.0",
    "mediabunny": "1.59.1",
    "next": "16.3.6",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
