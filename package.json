{
  "name": "bullpen-log",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "backup": "node --env-file=.env scripts/backup.mjs",
    "restore": "node --env-file=.env scripts/restore.mjs",
    "icons": "node scripts/make-icons.mjs",
    "training:test": "node --env-file=.env --import ./scripts/alias-register.mjs scripts/training-selftest.mts",
    "personalize:check": "node --env-file=.env --import ./scripts/alias-register.mjs scripts/personalize-check.mts",
    "equipment:check": "node --env-file=.env --import ./scripts/alias-register.mjs scripts/equipment-check.mts",
    "theme:check": "node --env-file=.env --import ./scripts/alias-register.mjs scripts/theme-time-check.mts",
    "outbox:test": "node scripts/outbox-selftest.mts",
    "velocity:test": "node scripts/velocity-selftest.mts",
    "velocity:detect-test": "node scripts/velocity-detect-test.mts",
    "rotation:check": "node --env-file=.env --import ./scripts/alias-register.mjs scripts/rotation-check.mts",
    "patch:sync": "node scripts/sync-patch-notes.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@supabase/supabase-js": "^2.111.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "jose": "^6.2.5",
    "lucide-react": "^1.28.0",
    "next": "16.3.6",
    "pg": "^8.22.0",
    "pretendard": "^1.3.9",
    "react": "19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
