#!/bin/sh
#
# 올리기 직전에 패치노트를 맞춘다.
#
# 커밋할 때마다 하지 않고 push 때만 하는 이유: 맞추는 일은 DB 에 접속해야 해서
# 몇 초가 걸린다. 커밋은 하루에 열 번도 하지만 push 는 몇 번 안 한다. 그리고
# 상대방이 볼 수 있게 되는 시점도 push 라, 그때 맞춰 두는 것이 앞뒤가 맞는다.
#
# 무슨 일이 있어도 push 를 막지 않는다. 인터넷이 끊겼거나 .env 가 없어서
# 패치노트를 못 맞추는 것과, 코드를 못 올리는 것은 무게가 다르다. 그래서
# 마지막은 늘 exit 0 이다.

if [ ! -f .env ]; then
  echo "· 패치노트: .env 가 없어 건너뜁니다."
  exit 0
fi

echo "· 패치노트를 맞추는 중…"
if node scripts/sync-patch-notes.mjs; then
  :
else
  echo "· 패치노트를 못 맞췄습니다. 올리는 것은 그대로 진행합니다."
  echo "  (나중에 'npm run patch:sync' 로 다시 맞출 수 있습니다.)"
fi

exit 0
