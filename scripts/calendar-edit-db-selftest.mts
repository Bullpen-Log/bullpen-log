import assert from 'node:assert/strict';
import { execSync } from 'node:child_process';
import { PGlite } from '@electric-sql/pglite';
import { PGLiteSocketServer } from '@electric-sql/pglite-socket';
import { PrismaClient } from '@prisma/client';
import { PrismaPg } from '@prisma/adapter-pg';
import { readCalendarEvent, writeCalendarEvent, verifyCalendarEvent } from '@/lib/calendar-write';
import { newEventId } from '@/lib/calendar-edit';
let passed = 0;const check = (v: unknown, label: string) => { assert.ok(v, label);passed++; };
const sql = execSync('npx prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script', { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] });
const pg = await PGlite.create();await pg.exec(sql);
const server = new PGLiteSocketServer({ db: pg, port: 0, host: '127.0.0.1' });await server.start();
const port = (server as unknown as { server: { address(): { port: number } } }).server.address().port;
const db = new PrismaClient({ adapter: new PrismaPg({ connectionString: `postgresql://postgres@127.0.0.1:${port}/postgres?sslmode=disable`, max: 1 }) });
try {
  const a = await db.user.create({ data: { email: 'a@test.invalid', nickname: 'A', password: 'x', role: 'ADMIN' } });
  const b = await db.user.create({ data: { email: 'b@test.invalid', nickname: 'B', password: 'x', role: 'ADMIN' } });
  const today = '2026-11-02', now = new Date('2026-11-02T00:00:00Z');
  const command = { op: 'create' as const, id: newEventId(), input: { title: '불펜', date: '2026-11-03', time: '18:00', remindMin: 30, memo: '운동장' } };
  const create = await writeCalendarEvent(db, a.id, command, today, now);assert.ok(create.ok && create.event);check(await db.calendarEvent.count() === 1, 'created one');
  const replay = await writeCalendarEvent(db, a.id, command, today, now);check(replay.ok && await db.calendarEvent.count() === 1, 'replayed create has one row');
  check(!(await writeCalendarEvent(db, a.id, { ...command, input: { ...command.input, title: '다른 일정' } }, today, now)).ok, 'same id different data rejected');
  check(!(await writeCalendarEvent(db, b.id, command, today, now)).ok, 'id collision cannot overwrite other owner');
  const own = await readCalendarEvent(db, a, command.id), other = await readCalendarEvent(db, b, command.id);check(own.ok && own.event?.owner === undefined && other.ok && other.event?.owner !== undefined, 'read-only owner label');
  const member = { id: b.id, role: 'USER' };const hidden = await readCalendarEvent(db, member, command.id);check(hidden.ok && hidden.event === null, 'member cannot read other event');
  const update = { op: 'update' as const, id: command.id, version: create.event.version, input: { ...command.input, title: '레슨', date: '2026-12-05' } };
  const beforeVerify = await verifyCalendarEvent(db, a.id, update, today);check(beforeVerify.ok && beforeVerify.state === 'not-applied', 'update not applied reads only');
  const saved = await writeCalendarEvent(db, a.id, update, today, now);assert.ok(saved.ok && saved.event);check(saved.event.date === '2026-12-05' && saved.event.version !== create.event.version, 'date moved and version advanced');
  check((await writeCalendarEvent(db, a.id, update, today, now)).ok, 'same target replay succeeds');
  const stale = await writeCalendarEvent(db, a.id, { ...update, input: command.input }, today, now);check(!stale.ok && stale.conflict, 'stale version rejected');
  const applied = await verifyCalendarEvent(db, a.id, update, today);check(applied.ok && applied.state === 'applied', 'lost update ack verified');
  const count = await db.calendarEvent.count();await verifyCalendarEvent(db, a.id, { ...command, id: newEventId() }, today);check(await db.calendarEvent.count() === count, 'create verification never inserts');
  const badDelete = { op: 'delete' as const, id: command.id, version: create.event.version };
  check(!(await writeCalendarEvent(db, a.id, badDelete, today, now)).ok && await db.calendarEvent.count() === 1, 'stale delete cannot remove updated row');
  await writeCalendarEvent(db, b.id, { ...badDelete, version: saved.event.version }, today, now);check(await db.calendarEvent.count() === 1, 'other-owner delete cannot remove row');
  const deletion = { ...badDelete, version: saved.event.version };const dv = await verifyCalendarEvent(db, a.id, deletion, today);check(dv.ok && dv.state === 'not-applied', 'delete verification leaves row');
  check((await writeCalendarEvent(db, a.id, deletion, today, now)).ok && await db.calendarEvent.count() === 0, 'CAS deletion');
  check((await writeCalendarEvent(db, a.id, deletion, today, now)).ok, 'delete replay safe');
  const verified = await verifyCalendarEvent(db, a.id, deletion, today);check(verified.ok && verified.state === 'applied', 'absent delete verified without mutation');
  console.log(`calendar edit DB: ${passed} checks passed (isolated PGlite only)`);
} finally { await db.$disconnect();await server.stop();await pg.close(); }
