/** 부상을 막는다고 약속하지 않는다 — scripts/training-selftest.mts 가 자세히 보기 글에 거는 것과 같은 규칙 */
const PROMISE = /(부상|손상|통증)을 (막|예방)|예방합니다|예방해 줍니다|예방할 수 있/;

const apply = process.argv.includes('--apply');
const rows = await prisma.exerciseVideo.findMany({
  where: { hiddenAt: null, description: { contains: HEAD } },
  select: { id: true, title: true, description: true },
});

const updates: { id: string; title: string; description: string }[] = [];
const missing: string[] = [];
for (const r of rows) {
  const e = W[r.title];
  if (!e) {
    missing.push(r.title);
    continue;
  }
  const at = r.description.indexOf(HEAD);
  const description = `${r.description.slice(0, at)}${HEAD}\n${e.why}`;
  if (description !== r.description)
    updates.push({ id: r.id, title: r.title, description });
}
const unused = Object.keys(W).filter((t) => !rows.some((r) => r.title === t));
const bad = Object.entries(W).filter(
  ([, e]) => PROMISE.test(e.why) || e.why.includes('—') || e.src.length === 0
);
console.log(
  `'왜' 칸이 있는 운동 ${rows.length}개 · 새 글 ${updates.length}개 · 글 없음 ${missing.length} · 안 쓴 글 ${unused.length} · 규칙 어김 ${bad.length}`
);
if (missing.length) console.log('  글 없음:', missing.join(', '));
if (unused.length) console.log('  안 쓴 글:', unused.join(', '));
if (bad.length) console.log('  규칙 어김:', bad.map(([t]) => t).join(', '));
if (process.argv.includes('--show'))
  for (const u of updates)
    console.log(
      `\n=== ${u.title}\n${u.description.slice(u.description.indexOf(HEAD))}`
    );
if (apply) {
  if (missing.length || bad.length) {
    console.log('글이 빠졌거나 규칙을 어긴 것이 있어 쓰지 않았어요');
  } else {
    for (const u of updates)
      await prisma.exerciseVideo.update({
        where: { id: u.id },
        data: { description: u.description },
      });
    console.log(`DB 에 ${updates.length}개 썼어요`);
  }
}
await prisma.$disconnect();
