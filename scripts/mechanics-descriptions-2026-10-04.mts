/** 도구만 다른 드릴의 도구 이름 — drills.ts toolOf 와 같은 규칙 */
function toolOf(title: string, category: string, equipment: string[]): string | null {
  if (title.endsWith('(큰 공)')) return '큰 메디신볼';
  if (title.endsWith('(작은 공)')) return '작은 메디신볼';
  if (category === '스로잉 드릴' && equipment.includes('야구공')) return '야구공';
  return null;
}

function compose(e: Entry, toolLine: string | null, category: string): string {
  const what = toolLine ? `${e.what} ${toolLine}` : e.what;
  const base = category === '스로잉 드릴' ? THROW_PACE : category === '메디신볼 드릴' ? MEDBALL_PACE : null;
  const pace = e.pace === 'none' ? null : (e.pace ?? base);
  const parts = [
    `■ 어떤 운동인가\n${what}`,
    `■ 이렇게 하세요\n${e.steps.map((s, i) => `${i + 1}. ${s}`).join('\n')}`,
    `■ 왜 하나요\n${e.why}`,
  ];
  if (pace) parts.push(`■ 세기\n${pace}`);
  return parts.join('\n\n');
}

const apply = process.argv.includes('--apply');
const rows = await prisma.mechanicsGuide.findMany({
  where: { hiddenAt: null },
  select: { id: true, title: true, category: true, equipment: true, description: true },
});
/* 같은 묶음에 도구가 여럿일 때만 도구 줄을 붙인다 */
const familySize = new Map<string, number>();
for (const r of rows) familySize.set(familyTitle(r.title), (familySize.get(familyTitle(r.title)) ?? 0) + 1);
let missing = 0;
const updates: { id: string; title: string; description: string }[] = [];
for (const r of rows) {
  const key = r.title.replace(/\s*\((큰|작은) 공\)\s*$/, '').trim();
  const e = D[key];
  if (!e) {
    missing += 1;
    console.log('  설명 없음:', r.title);
    continue;
  }
  const tool = (familySize.get(familyTitle(r.title)) ?? 1) > 1 ? toolOf(r.title, r.category, r.equipment) : null;
  updates.push({ id: r.id, title: r.title, description: compose(e, tool ? TOOL_LINE[tool] : null, r.category) });
}
const unused = Object.keys(D).filter((k) => !rows.some((r) => r.title.replace(/\s*\((큰|작은) 공\)\s*$/, '').trim() === k));
console.log(`보이는 드릴 ${rows.length}개 · 새 글 ${updates.length}개 · 없음 ${missing} · 안 쓴 글 ${unused.length}${unused.length ? ` (${unused.join(', ')})` : ''}`);
if (process.argv.includes("--show")) for (const u of updates) console.log(`\n=== ${u.title}\n${u.description}`);
if (apply) {
  /* 이 스크립트 뒤에 따로 넣은 드릴(scripts/mechanics-new-drills-2026-10-04.mts)은 거기서 설명을 쓴다 — 건너뛴다 */
  if (missing > 0) console.log(`설명이 여기 없는 드릴 ${missing}개는 건너뛰어요`);
  for (const u of updates) {
    await prisma.mechanicsGuide.update({ where: { id: u.id }, data: { description: u.description } });
  }
  console.log(`DB 에 ${updates.length}개 썼어요`);
}
await prisma.$disconnect();
