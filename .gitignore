# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 개인 촬영 계획 (로컬 전용)
촬영-리스트/

# DB 백업(npm run backup) — 회원 이메일·비밀번호 해시가 들어 있어 절대 올리지 않는다.
# 기본 위치는 저장소 바깥(~/bullpen-log-backups)인데, 프로젝트 폴더 안에 두는
# 컴퓨터도 있어서 여기서도 막아 둔다.
/bullpen-log-backups/

# 작업하다 만든 임시 파일·기록 — 실수로 올라가지 않게
# (예전에 .tok.tmp · .lowcond.tmp.mjs · .dev.log 가 올라가 있었다)
*.tmp
*.tmp.*
*.log
