{
  "appId": "com.bullpenlog.app",
  "appName": "Bullpen Log",
  "webDir": "www",
  "appendUserAgent": "BullpenLogApp/1.0",
  "server": {
    "url": "https://bullpen-log.vercel.app/today",
    "allowNavigation": ["bullpen-log.vercel.app"],
    "errorPath": "offline.html"
  },
  "ios": {
    "contentInset": "never"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 4000,
      "launchAutoHide": true,
      "showSpinner": true,
      "iosSpinnerStyle": "small",
      "spinnerColor": "#94a3b8"
    },
    "SystemBars": {
      "style": "LIGHT"
    }
  }
}
