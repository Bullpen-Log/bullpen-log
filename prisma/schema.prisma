datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

/// 운동 영상의 출처. 직접 찍은 것과 참고용으로 걸어둔 것을 구분한다.
enum ExerciseSource {
  /// 직접 촬영해 저장소에 올린 영상
  OWN
  /// 아직 촬영 전이라 유튜브 참고 영상으로 대신하는 것
  REFERENCE
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  nickname            String
  /// 프로필 사진이 저장소에 놓인 자리(<userId>/avatar-….jpg). 안 올렸으면 비어 있다.
  /// 투구 영상과 같은 비공개 저장소에 들어가고, 볼 때마다 서명된 임시 주소를 만든다.
  avatarPath          String?
  role                Role      @default(USER)
  /// 생년월일. 나이에 따라 안전한 투구수 한도가 달라져 투구량 조언에 필요하다.
  birthDate           DateTime? @db.Date
  /// 키(cm). 영상에서 잰 길이를 몸 크기로 나눠 비교할 때 쓴다.
  heightCm            Int?
  /// 몸무게(kg). 소수 한 자리까지 적을 수 있어 Float 으로 둔다.
  /// 화면에서는 설정한 단위(kg·lb)로 보여주지만 여기에는 늘 kg 으로 담는다.
  weightKg            Float?
  /// 윙스팬(cm) — 양팔을 벌린 길이. 키와 함께 몸 크기를 재는 값이다.
  /// 투수는 팔이 길수록 릴리스 포인트가 앞으로 나와, 같은 구속도 다르게 느껴진다.
  wingspanCm          Float?
  /// 목표 최고 구속(km/h). 지금 구속과의 격차를 보여주는 기준이 된다.
  targetVelocity      Int?
  /// 던지는 손. 폼 분석에서 어느 팔을 보는지 정한다.
  /// 이름은 lib/baseline.ts의 THROWING_HANDS 안에서만 쓴다.
  throwingHand        String?
  /// 어디서 야구를 하는지 — 초등학교/중학교/…/사회인.
  ///
  /// 이 값으로 무엇을 강제로 바꾸지는 않는다. 나이는 생년월일로 이미 알고 있고,
  /// 안전 한도도 거기서 나온다. 나중에 "고등학교 투수들은 보통 어떤지"를 보려고
  /// 모으는 값이다. 이름은 lib/baseline.ts의 COMPETITION_LEVELS 안에서만 쓴다.
  competitionLevel    String?
  /// 가입 문진 — 평소 투구량. 부하 지수의 추정 기준선을 만든다. (lib/baseline.ts)
  baselineFreq        String?
  baselineVolume      String?
  baselineIntensity   String?
  /// 가입 문진 — 평소 웨이트 빈도. 운동 부하 지수의 추정 기준선을 만든다.
  ///
  /// 없으면 운동 지수는 28일이 쌓여야 나온다. 투구는 위 세 문항 덕에 첫날부터
  /// 나오는데 운동만 한 달을 기다리는 것은 앞뒤가 안 맞아서 함께 받는다.
  baselineWorkoutFreq String?
  /// 하루 운동 시간(분). 오늘의 운동 종목 수를 이 시간에 맞춰 계산한다.
  /// 비어 있으면 기본값(lib/report/theme.ts의 DEFAULT_WORKOUT_MINUTES)을 쓴다.
  dailyWorkoutMinutes Int?
  /// 웨이트 트레이닝 경력. 어떤 난이도의 운동까지 줄지 정한다.
  /// 비어 있으면 아직 안 골랐다는 뜻이라 아무것도 빼지 않는다.
  /// 이름은 lib/report/personalize.ts의 TRAINING_LEVELS 안에서만 쓴다.
  trainingLevel       String?
  /// 훈련 목표. 구간별 시간 배분을 바꾼다. 비어 있으면 '균형 잡힌 관리'로 본다.
  /// 이름은 lib/report/personalize.ts의 TRAINING_GOALS 안에서만 쓴다.
  trainingGoal        String?
  /// 목표 안에서 오늘 어느 부위를 할지. 비어 있으면 앱이 번갈아 정한다.
  ///
  /// 목표(trainingGoal)는 '같은 시간을 어디에 더 쓸까'를 정하고, 상체·하체는
  /// 앱이 최근 기록을 보고 번갈아 골라 왔다. 그런데 "오늘은 당기기만 하고
  /// 싶다"는 사람에게는 그 자동이 방해가 된다. 좁히고 싶을 때만 쓰는 값이라
  /// 비어 있는 것이 기본이고, 그때는 예전처럼 앱이 정한다.
  ///
  /// 값은 lib/report/personalize.ts의 GOAL_FOCUSES 안에서만 쓴다.
  trainingFocus       String?
  /// 가지고 있는 운동 장비. AI 트레이닝에서 할 수 없는 운동을 빼는 데 쓴다.
  /// 비어 있으면 아직 안 골랐다는 뜻이라 아무것도 빼지 않는다.
  /// 이름은 lib/exercise-meta.ts의 EXERCISE_EQUIPMENT 안에서만 쓴다.
  ownedEquipment      String[]
  createdAt           DateTime  @default(now())

  exerciseFavorites UserExerciseFavorite[]
  drillFavorites    UserDrillFavorite[]
  drillLogs         UserDrillLog[]
  pitchLogs         PitchLog[]
  userExerciseLogs  UserExerciseLog[]
  workoutSessions   TrainingSession[]
  articles          Article[]
  checkins          DailyCheckin[]
  aiReports         AiReport[]
  trainingSetups    DailyTrainingSetup[]
  trainingNotes     DailyTrainingNote[]
}

/**
 * 생성된 AI 리포트. 한 번 만든 리포트는 그대로 보관해
 * 다시 열어도 같은 내용과 같은 근거가 보이게 한다.
 */
model AiReport {
  id           String   @id @default(uuid())
  userId       String
  /// 리포트 기준일
  asOf         DateTime @db.Date
  /// 통증 등으로 투구 계획을 내지 않은 리포트인가
  halted       Boolean  @default(false)
  haltReason   String?  @db.Text
  /// AI가 쓴 본문. 계획이 멈춘 리포트에는 없다(AI를 부르지 않음).
  body         Json?
  /// 생성 시점의 수치와 계획. 근거를 나중에도 그대로 보여주기 위해 함께 저장한다.
  facts        Json
  plan         Json
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, asOf])
  @@index([userId, asOf])
}

/// 하루 한 번 남기는 몸상태 체크인. 운동 처방과 리포트의 입력이 된다.
/// 그날 하루의 훈련 설정.
///
/// 장비는 날마다 다르다. 집에서 하는 날과 헬스장 가는 날에 쓸 수 있는 것이
/// 다른데, 프로필에 한 번 적어둔 목록만 보면 오늘 없는 기구가 계속 나온다.
/// 그래서 '가지고 있는 것'(User.ownedEquipment)과 '오늘 쓸 수 있는 것'을
/// 나눠 두고, 오늘 것은 날짜별로 여기에 남긴다.
///
/// 이 줄이 없는 날은 아직 안 고른 날이라, 가진 것을 다 쓸 수 있다고 본다.
model DailyTrainingSetup {
  id                 String    @id @default(uuid())
  userId             String
  date               DateTime  @db.Date
  /// 오늘 쓸 수 있는 장비. 이름은 lib/exercise-meta.ts의 EXERCISE_EQUIPMENT 안에서만 쓴다.
  availableEquipment String[]
  /// 만들어 둔 오늘의 운동 일정. 없으면 아직 안 만든 날이다.
  ///
  /// 화면을 열 때마다 새로 계산하지 않고 만든 것을 그대로 보여준다. 그러지 않으면
  /// 아침에 본 일정과 저녁에 본 일정이 달라진다 — 최근에 한 운동을 뒤로 미루는
  /// 규칙 때문에 새로고침만 해도 바뀔 수 있다.
  ///
  /// 다만 안전은 볼 때마다 다시 본다. 만든 뒤에 통증을 입력했다면 저장해 둔
  /// 일정이 있어도 보여주지 않는다. 모양은 lib/report/daily-plan.ts의 DailyPlan.
  plan               Json?
  generatedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model DailyCheckin {
  id               String   @id @default(uuid())
  userId           String
  date             DateTime @db.Date
  /// 각 부위 느낌: 정상 / 뻐근 / 통증 (lib/checkin.ts의 CHECKIN_PARTS와 짝을 이룬다)
  shoulder         String
  elbow            String
  wrist            String   @default("정상")
  lowerBack        String   @default("정상")
  lowerBody        String   @default("정상")
  /// 전신 컨디션 1(안 좋음) ~ 10(최상). 높을수록 좋다.
  condition        Int
  /// 수면: 충분 / 보통 / 부족
  sleep            String
  /// 오늘 하고 싶은 운동 부위. 비워두면 가리지 않는다.
  /// 안전 필터를 뚫는 값이 아니라, 통과한 후보 중 순서를 바꾸는 데만 쓴다.
  preferredParts   String[]
  /// 오늘 하고 싶은 운동 종류: 파워 / 웨이트 / 회복. 비워두면 '추천대로'.
  /// 부위와 같은 성격이다 — 순서를 바꾸고 테마를 고르는 데 쓰되, 통증이 있는
  /// 날에는 무엇을 골랐든 회복으로 간다.
  preferredWorkout String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model MechanicsGuide {
  id               String              @id @default(uuid())
  title            String
  category         String              @default("스로잉 드릴")
  description      String              @db.Text
  /// 저장소에 올린 영상 경로. 참고 영상(REFERENCE)은 유튜브에서 재생하므로 비어 있다.
  videoPath        String?
  /// 재생 전에 보여줄 미리보기 이미지 경로. 없으면 빈 화면으로 표시한다.
  thumbPath        String?
  /// 영상 출처 — 운동(ExerciseVideo)과 같은 규칙이다.
  source           ExerciseSource      @default(OWN)
  /// 참고 영상의 유튜브 영상 ID (11자). source 가 REFERENCE 일 때만 채운다.
  referenceVideoId String?
  /// 영상의 가로세로 비율. 운동 영상과 같은 규칙이다(ExerciseVideo.aspectRatio).
  aspectRatio      Float?
  /// 이 드릴이 무엇을 교정하는지. 영상분석 결과와 이어지는 고리다.
  focusPoints      String[]
  /// 드릴에 필요한 도구
  equipment        String[]
  sortOrder        Int                 @default(0)
  createdAt        DateTime            @default(now())
  favorites        UserDrillFavorite[]
  drillLogs        UserDrillLog[]
}

/**
 * 오늘 이 드릴을 했다.
 * 즐겨찾기와 다른 것이다. 저쪽은 '다시 찾기 쉽게 달아 둔 별'이라 날짜가 없고,
 * 이쪽은 '그날 했다'는 기록이다. 둘을 하나로 두면 "이번 주에 드릴 몇 번 했나"를
 * 셀 수가 없다.
 * 세트나 횟수를 두지 않는다. 드릴은 앱이 "몇 번 해라"라고 정해 주는 것이
 * 아니라, 선수가 설명을 읽고 필요한 것을 골라서 하는 것이다. 우리가 아는 것은
 * '골랐다'와 '했다'까지다.
 */
model UserDrillLog {
  userId  String
  guideId String
  date    DateTime @db.Date

  /// 골라 담기만 하고 아직 안 한 상태와, 하고 나서 체크한 상태를 가른다.
  done Boolean @default(false)

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  guide MechanicsGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@id([userId, guideId, date])
  @@index([userId, date])
}

/**
 * 즐겨찾기 — 운동.
 * 앱이 골라 준 일정을 손으로 고치는 순간에 쓰는 표다. 445개 중에서 "그 운동"을
 * 다시 찾는 것이 일이라, 마음에 든 것에 별을 달아두고 운동을 더할 때 위에서
 * 바로 집는다.
 * 앱이 무엇을 고를지에는 영향을 주지 않는다. 별을 달았다고 그 운동이 더 자주
 * 나오면, 같은 운동만 반복하지 않게 텀을 두고 돌리기로 한 결정을 되돌리는 셈이다.
 * 이 표는 '찾기'에만 쓴다.
 */
model UserExerciseFavorite {
  userId     String
  exerciseId String
  createdAt  DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise ExerciseVideo @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([userId, exerciseId])
  @@index([userId])
}

/**
 * 즐겨찾기 — 투구 드릴. 운동 쪽과 같은 뜻이고, 드릴 고르는 창에서 쓴다.
 */
model UserDrillFavorite {
  userId    String
  guideId   String
  createdAt DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  guide MechanicsGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@id([userId, guideId])
  @@index([userId])
}

model PitchLog {
  id          String   @id @default(uuid())
  userId      String
  date        DateTime @db.Date
  /// 불펜 / 라이브 / 경기 / 캐치볼. 같은 투구수라도 성격이 달라 나눠 본다.
  sessionType String   @default("불펜")
  pitchCount  Int
  intensity   Int
  /// 최고·평균 구속(km/h). 둘 다 없어도 된다.
  ///
  /// 스피드건이 없는 선수가 훨씬 많다. 구속을 필수로 두면 그 선수들은 기록
  /// 자체를 못 남기고, 기록이 없으면 부하 지수도 AI 트레이닝도 돌지 않아
  /// 앱이 아무 일도 못 하게 된다. 부하는 투구수 × 강도로 내므로 구속이
  /// 없어도 안전 계산은 그대로 돌아간다.
  maxVelocity Float?
  avgVelocity Float?
  memo        String?  @db.Text
  /// 그날 던진 영상의 저장소 경로. 최대 2개까지 저장한다.
  videoPaths  String[]
  createdAt   DateTime @default(now())

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  poseAnalyses PoseAnalysis[]
}

/**
 * 폼 분석 결과. 영상 하나당 최신 분석 1개를 보관해 다시 열 때
 * 재분석 없이 바로 보여주고, 지난 세션과의 변화 비교에 쓴다.
 * 측면 촬영이 아니거나 인식이 나쁜 분석은 저장하지 않는다(비교 오염 방지).
 */
model PoseAnalysis {
  id               String   @id @default(uuid())
  userId           String
  pitchLogId       String
  /// PitchLog.videoPaths 중 어떤 영상의 분석인지
  videoPath        String   @unique
  /// 화면 표기용 좌/우투 (사용자가 전환 버튼으로 고칠 수 있음)
  throwingSide     String
  /// 실제 측정에 쓴 팔 (인식 라벨 기준)
  wristSide        String
  leadSide         String
  direction        Int
  quality          Float
  coverage         Float
  /// 자동 감지된 구간 (초)
  kneeUpT          Float?
  footPlantT       Float?
  releaseT         Float?
  /// 사용자가 프레임으로 직접 보정한 구간 (초)
  kneeUpManualT    Float?
  footPlantManualT Float?
  releaseManualT   Float?
  /// 지표 배열 [{key,label,phase,value,display,reason,confidence}]
  metrics          Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  pitchLog PitchLog @relation(fields: [pitchLogId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ExerciseVideo {
  id               String                 @id @default(uuid())
  title            String
  category         String
  description      String                 @db.Text
  /**
   * 저장소에 올린 영상 경로 (library/... ).
   * 참고 영상(source = REFERENCE)은 유튜브에서 바로 재생하므로 비어 있다.
   * 직접 촬영한 영상을 나중에 올리면 이 값이 채워지고 source 가 OWN 으로 바뀐다.
   */
  videoPath        String?
  /// 재생 전에 보여줄 미리보기 이미지 경로. 없으면 빈 화면으로 표시한다.
  thumbPath        String?
  /**
   * 영상의 출처.
   * OWN       — 직접 찍어 올린 영상. videoPath 를 쓴다.
   * REFERENCE — 아직 촬영하지 않아 유튜브 참고 영상으로 대신하는 것.
   * 영상과 미리보기 모두 유튜브 주소를 가리키기만 하고
   * 우리 저장소에는 아무것도 담지 않는다.
   */
  source           ExerciseSource         @default(OWN)
  /// 참고 영상의 유튜브 영상 ID (11자). source 가 REFERENCE 일 때만 채운다.
  referenceVideoId String?
  /// 이 운동이 목표로 하는 부위
  bodyParts        String[]
  /**
   * 몸을 어떤 방식으로 쓰는가 — 힌지·스쿼트·런지·밀기·당기기·회전·운반.
   * bodyParts 와 다른 축이다. 저쪽은 '어느 근육을 쓰나'이고 이것은 '어떻게
   * 움직이나'다. 데드리프트와 스쿼트는 둘 다 하체지만 몸을 쓰는 방식이 다르고,
   * 트레이너가 하루 구성을 짤 때 반드시 나누는 축이 이쪽이다.
   * 없으면 왜 곤란한가. 카테고리(하체 스트렝스)만 맞으면 무엇이든 들어가서,
   * 60일 중 25일은 본운동이 무릎 계열(스쿼트·런지)만으로 채워졌다. 구속은
   * 뒤쪽 사슬 — 햄스트링과 둔근 — 에서 나오는데 그쪽이 통째로 빠지는 날이다.
   * 비어 있어도 된다. 스트레칭이나 암케어처럼 이 축으로 가를 것이 없는 운동이
   * 많다. 비면 '계열이 겹치나'를 따질 때 그냥 지나간다.
   */
  movementPattern  String?
  /// 매우 낮음 / 낮음 / 중간 / 높음 / 매우 높음 (lib/exercise-meta.ts)
  /// 부하가 높거나 몸이 안 좋은 날 위쪽 단계를 후보에서 빼는 데 쓴다.
  intensity        String                 @default("중간")
  /// 초급 / 중급 / 상급. 선택 입력이라 비어 있을 수 있다.
  difficulty       String?
  /// 운동에 필요한 도구
  equipment        String[]
  /**
   * 처방 단위 — 몇 세트를 몇 번(또는 몇 초) 하고 얼마나 쉬는가.
   * 이것이 없으면 "데드버그 하세요"까지만 알려주는 셈이라, 초보~중급자가
   * 실제로 무엇을 얼마나 해야 하는지 알 수 없다. 오늘의 운동에서 시간을
   * 어림하는 데도 쓰인다 — 예전에는 카테고리마다 정해진 값으로 어림해서,
   * 월 싯 30초와 바벨 스쿼트 5세트가 같은 시간으로 계산됐다.
   */
  sets             Int?
  /// 한 세트에 하는 횟수. 시간으로 버티는 운동은 비어 있고 holdSeconds 를 쓴다.
  reps             Int?
  /// 한 세트에 버티는 시간(초). 횟수로 하는 운동은 비어 있다.
  holdSeconds      Int?
  /// 세트 사이 쉬는 시간(초)
  restSeconds      Int?
  /// 좌우를 나눠 하는 운동인가. 그렇다면 한 세트에 양쪽을 다 한다.
  perSide          Boolean                @default(false)
  /**
   * 영상의 가로세로 비율 (가로 ÷ 세로).
   * 16:9 가로면 1.78, 9:16 세로면 0.56 이다. 비어 있으면 가로(16:9)로 본다 —
   * 지금 들어 있는 참고 영상은 재보니 전부 1920x1080 이라, 비워 두면 예전과
   * 똑같이 나온다.
   * 왜 저장하나: 요즘 운동 채널은 대부분 세로 쇼츠로 찍는다. 세로 영상을 16:9
   * 틀에 넣으면 좌우가 검게 막히고, 420px 자리에서 실제 영상이 158px 로
   * 쪼그라든다. 재생기에서는 알 길이 없어(유튜브 iframe 은 크기를 안 알려준다)
   * 등록할 때 한 번 재서 적어 둔다.
   */
  aspectRatio      Float?
  /**
   * 세부 정보(설명·강도·부위·난이도·장비)를 제대로 채운 시각.
   * 비어 있으면 제목과 영상만 올린 상태로 본다. 나중에 정보를 채우는 작업을
   * 할 때 이 값이 있는 것은 건드리지 않아, 이미 손본 내용을 덮어쓰지 않는다.
   */
  detailsFilledAt  DateTime?
  /**
   * 숨긴 시각. 비어 있으면 보이는 운동이다.
   * 지우기 대신 쓴다. 운동을 지우면 그 운동을 한 모든 회원의 기록이 함께
   * 사라지고(UserExerciseLog 가 딸려 있다), 지나간 운동 부하까지 소급해서
   * 바뀐다. 어제 "부하 1.2"였던 사람이 오늘 "0.9"가 되는데 본인은 아무것도
   * 안 했다 — 관리자가 "이 영상 다시 찍어야겠다" 하고 지운 것만으로.
   * 숨기면 새 일정에는 안 나오고 지난 기록은 그대로 남는다. 관리자 화면에서
   * 언제든 되돌릴 수 있다.
   */
  hiddenAt         DateTime?
  createdAt        DateTime               @default(now())
  userLogs         UserExerciseLog[]
  favorites        UserExerciseFavorite[]
  warmupItems      WarmupRoutineItem[]
  workoutSets      UserExerciseSet[]
}

model UserExerciseLog {
  userId     String
  exerciseId String
  date       DateTime @db.Date
  completed  Boolean  @default(false)

  /// 실제로 한 세트 수. 안 적었으면 null.
  ///
  /// 계획값을 미리 채워 두지 않는다. 눌러서 넘어가기는 편하지만, 실제로 한 것과
  /// 다른 숫자가 그대로 저장된다. 그 숫자로 운동 부하를 계산하므로 편한 것보다
  /// 맞는 것이 먼저다. 안 적으면 '한 것은 맞지만 얼마나 했는지는 모름'이 된다.
  setsDone        Int?
  /// 세트당 실제로 한 횟수. 시간형 운동(버티기)이면 null.
  repsDone        Int?
  /// 세트당 실제로 버틴 시간(초). 횟수형 운동이면 null.
  holdSecondsDone Int?
  /**
   * 그날 가장 무겁게 든 세트의 무게(kg). 안 적었거나 맨몸이면 null.
   * 세트마다 무게를 올리는 사람이 대부분이라(40 → 50 → 60), '실제로 든 무게'
   * 하나로는 무엇을 적어야 할지 알 수 없었다. 가장 무거웠던 세트로 못박는다 —
   * 사람이 기억하는 숫자이고, 증량을 정하는 것도 그 숫자다.
   * 부하 계산은 절대값이 아니라 '평소 내 톱세트 대비 몇 배'를 쓰므로,
   * 늘 같은 기준으로만 적으면 정확하다(lib/training-load.ts 의 weightFactor).
   * 소수를 담는다. 원판은 2.5kg 단위로 늘어난다 — 62.5를 못 적으면 실제로
   * 쓰는 무게의 절반을 못 적는 셈이다.
   */
  weightKg        Float?

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise ExerciseVideo @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([userId, exerciseId, date])
}

/**
 * 그날 운동이 어땠는지 — 하루에 하나.
 * 세트·횟수는 운동마다 다르지만, "오늘 운동이 얼마나 힘들었나"는 하루에 하나면
 * 된다. 운동 열 개에 강도를 열 번 적게 하면 아무도 안 적는다.
 * 계획(DailyTrainingSetup)과 표를 나눠 둔 이유는 성격이 달라서다. 저쪽은
 * '무엇을 할까'라 일정을 다시 만들면 통째로 덮어쓰는데, 이쪽은 '무엇을 했나'라
 * 한 번 적으면 남아야 한다. 같은 행에 두면 언젠가 함께 지워진다.
 */
model DailyTrainingNote {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date
  /// 오늘 운동 강도 1(아주 가벼움) ~ 10(전력). 투구 강도와 같은 눈금을 쓴다.
  intensity Int
  /// 그날 느낀점. 안 적어도 된다.
  memo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

/**
 * 고정 워밍업 루틴.
 * 일정을 만들 때 뽑는 것이 아니라, 미리 짜 두고 그대로 쓰는 묶음이다. 운동을
 * 시작하면 본운동에 들어가기 전에 '오늘 목적에 맞는 것 하나'와 '전신' 둘이
 * 뜬다. 한 것을 체크만 하고, 운동 시간과 운동량 계산에는 넣지 않는다.
 * kind 를 유일하게 둔다. 종류마다 하나씩만 두는 것이 이 기능의 뜻이다 —
 * 날마다 달라지는 것이 아니라 고정이라서 만든 것이다.
 */
model WarmupRoutine {
  id String @id @default(uuid())

  /// LOWER · UPPER_PUSH · UPPER_PULL · COMMON
  ///
  /// 그날 본운동의 동작 계열로 고른다. 힌지·스쿼트·런지·카프면 LOWER,
  /// 밀기면 UPPER_PUSH, 당기기면 UPPER_PULL. COMMON 은 언제나 함께 뜬다.
  /// 회복 데이에는 워밍업 자체가 없다.
  kind String @unique

  name        String
  /// 카드에 한 줄로 적히는 설명. 없어도 된다.
  description String @default("")
  sortOrder   Int    @default(0)

  /// 숨긴 시각. 지우지 않고 감춘다 — 담아 둔 운동을 잃지 않기 위해서다.
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  items WarmupRoutineItem[]
}

/**
 * 루틴 안에 담긴 운동 하나.
 * 운동 자체는 ExerciseVideo 에 '워밍업' 카테고리로 올린다. 영상·미리보기·
 * 설명·처방이 이미 다 있는 구조라, 워밍업만을 위한 것을 새로 만들지 않는다.
 */
model WarmupRoutineItem {
  routineId  String
  exerciseId String
  sortOrder  Int    @default(0)

  /// 이 루틴에서만 쓰는 안내. 비우면 운동에 적어 둔 처방을 그대로 쓴다.
  note String?

  routine  WarmupRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise ExerciseVideo @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([routineId, exerciseId])
  @@index([routineId])
  @@index([exerciseId])
}

/**
 * 운동 한 판.
 * 트레이닝 화면에서 [운동 시작]을 누르면 줄이 하나 생기고, [운동 종료]로
 * 닫힌다. 하루에 하나다 — 오후에 다시 들어오면 아침에 열어 둔 것을 이어서
 * 연다. 체감 강도를 하루 한 번만 남기는 구조(DailyTrainingNote)와 맞추기
 * 위해서다.
 */
model TrainingSession {
  id     String   @id @default(uuid())
  userId String
  /// 서버가 정한 날짜. 세트가 이 값을 베껴 써서 자정을 넘겨도 안 갈린다.
  date   DateTime @db.Date

  /// lower · upper · assist · recovery
  themeKey String

  /**
   * 시작할 때 찍어 둔 오늘의 운동 목록.
   * 얼려 두지 않으면 운동 중에 목록이 바뀐다. 실제로 바뀌는 길이 넷 있다 —
   * 홈에서 컨디션을 고치면 안전 재검사가 다시 돌고, 통증을 입력하면 목록이
   * 통째로 사라지고, 다른 탭에서 '일정 다시 만들기'를 누르면 같은 날 줄을
   * 덮어쓰고, 목록에서 운동을 빼면 그날 기록까지 지워진다.
   * 스쿼트 3세트 중에 화면에서 스쿼트가 사라지는 일을 막는다. 통증만은
   * 예외로 세션 중에도 반영해 "오늘은 여기까지"를 띄운다.
   */
  plan Json

  /// ACTIVE · FINISHED · ABANDONED
  status String @default("ACTIVE")

  /// 세션을 연 시각. 워밍업을 포함한다.
  startedAt     DateTime  @default(now())
  /**
   * 본운동에 들어간 시각.
   * 워밍업 창에서 [본운동 시작] 또는 [건너뛰기]를 누르는 순간 찍는다.
   * 종료 요약의 '운동 시간'은 이 시각부터 센다 — 워밍업은 시간 계산에
   * 넣지 않기 때문이다. 워밍업이 없는 날(회복 데이)에는 startedAt 과 같다.
   */
  mainStartedAt DateTime?
  endedAt       DateTime?

  /**
   * 마친 구간들의 운동 시간(초)을 더한 값.
   * 판은 [운동 더 하기]로 다시 열 수 있다. 다시 열면 mainStartedAt 을 새로
   * 찍는데(휴식 시계가 아까 남긴 세트부터 세지 않게), 그러면 마친 뒤
   * endedAt − mainStartedAt 은 마지막 구간만 남는다. 아침 45분 + 저녁 10분이
   * '10분'이 된다. 그래서 마칠 때마다 그 구간을 여기에 더해 둔다.
   * 워밍업은 들어가지 않는다 — mainStartedAt 부터 세기 때문이다.
   */
  activeSeconds Int @default(0)

  /// DONE · SKIPPED · null(워밍업이 없는 날)
  warmupOutcome String?
  /**
   * 체크한 워밍업 운동.
   * UserExerciseLog 에 줄을 만들지 않는다. 줄이 생기면 운동 부하·부위별 세트
   * 수·'최근에 한 운동'·달력의 개수까지 다섯 군데가 오염된다. 여기에 이름만
   * 남기고, 이 칸을 읽는 계산 파일은 하나도 없다.
   */
  warmupDoneIds String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sets UserExerciseSet[]

  @@unique([userId, date])
  @@index([userId])
}

/**
 * 세트 한 줄.
 * 한 세트를 마칠 때마다 줄이 하나 생긴다. 지금까지 쓰던 UserExerciseLog 는
 * 그대로 두고, 서버가 이 줄들에서 다시 계산해 채우는 '요약'으로 쓴다 —
 * 부하·부위별 세트 수·달력을 읽는 기존 코드가 전부 그대로 돈다.
 * setNo 를 두고 (세션, 운동, 번호)를 유일하게 묶는다. 신호가 끊겼다 다시
 * 보내도 같은 줄을 덮어쓸 뿐 두 번 쌓이지 않는다. 지우면 번호에 구멍이
 * 남지만, 화면에는 순서대로 '1세트·2세트'로 다시 매겨 보여준다.
 */
model UserExerciseSet {
  id         String   @id @default(uuid())
  sessionId  String
  /// 세션에서 베껴 온다. 이 사람의 기록만 모아 읽을 때 쓴다.
  userId     String
  exerciseId String
  /// 세션에서 베껴 온다. 자정을 넘겨도 세션 날짜 그대로다.
  date       DateTime @db.Date

  /// 1부터. 화면의 '1세트'와 같은 숫자로 시작하되, 지우면 구멍이 생긴다.
  setNo Int

  /// 실제로 든 무게(kg). 맨몸이면 없다. 0.5kg 자리까지 남긴다.
  weightKg    Float?
  /// 실제로 한 횟수. 시간형 운동이면 없다.
  reps        Int?
  /// 실제로 버틴 시간(초). 횟수형 운동이면 없다.
  holdSeconds Int?

  /**
   * 이 세트를 마친 시각.
   * 휴식 시계가 이 값에서 지금까지를 센다. 흘러가는 숫자를 들고 있지 않고
   * 시각 하나만 두므로, 화면이 꺼졌다 켜져도 쉰 시간이 정확하다.
   */
  recordedAt DateTime @default(now())

  session  TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise ExerciseVideo   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([sessionId, exerciseId, setNo])
  @@index([sessionId])
  @@index([userId, date])
  @@index([exerciseId])
}

model Article {
  id            String   @id @default(uuid())
  userId        String
  title         String
  content       String   @db.Text
  tags          String[]
  attachmentUrl String?
  views         Int      @default(0)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// 관리자가 공용 내용을 바꿀 때마다 한 줄씩 쌓이는 기록 — '패치노트'.
///
/// 같이 쓰는 것(운동 라이브러리·드릴 가이드·자료실)은 한 사람이 바꾸면 모두에게
/// 바뀐다. 그런데 무엇이 언제 왜 바뀌었는지 남는 곳이 없어서, 나중에 "이 운동
/// 설명 누가 고쳤지"를 물을 데가 없었다. 바뀌는 순간 자동으로 적는다.
///
/// 회원을 지워도 기록은 남아야 하므로 이름을 문자열로 함께 박아 둔다(authorName).
/// 관계로만 두면 탈퇴한 사람이 한 일이 통째로 사라진다.
/// 패치노트 — 프로그램을 고친 기록.
///
/// 한 장이 '누가 · 어느 날'이다. 그 사람이 그날 한 커밋을 전부 모아 한 장으로
/// 둔다. 커밋 하나하나를 한 장씩 두면 하루에 열 장씩 쌓여 무엇이 큰 일이었는지
/// 안 보이고, 사람 구분 없이 날짜로만 묶으면 둘이 같은 날 작업했을 때 누구 것인지
/// 섞인다.
///
/// 내용은 깃 기록에서 가져온다. 손으로 적는 것이 아니라 scripts/sync-patch-notes.mjs
/// 가 커밋을 읽어 채운다 — 적는 것을 잊어버릴 수 있는 자리를 아예 없앤다.
model PatchNote {
  id String @id @default(uuid())

  /// 고친 날. 'YYYY-MM-DD' 글자다.
  ///
  /// DateTime 을 쓰지 않는 이유는 시간대다. 날짜만 필요한데 시각을 함께 두면
  /// 보는 곳에 따라 하루가 밀린다 — 밤 늦게 한 작업이 다음 날로 넘어간다.
  day String

  /// 누가. 이름은 바뀔 수 있어서 묶는 열쇠는 메일 주소로 따로 둔다.
  authorKey  String
  authorName String

  /// 그날 그 사람의 커밋들.
  /// [{ sha, subject, body, files, insertions, deletions }]
  commits Json

  /// 한눈에 보는 크기. 목록에서 '큰 작업이었나'를 가늠하는 몫이다.
  commitCount  Int @default(0)
  filesChanged Int @default(0)
  insertions   Int @default(0)
  deletions    Int @default(0)

  /// 어디를 건드렸나 — '홈 화면', '데이터베이스' 처럼 사람 말로.
  /// 경로에서 자동으로 뽑는다. 같이 하는 사람이 제목만 보고 넘길지
  /// 열어볼지 정하는 데 쓴다.
  areas String[]

  /// 사람이 덧붙이는 글. 커밋 제목이 못 담는 '왜'를 적는 자리다.
  /// 여기만 사람이 고친다. 나머지는 다시 맞출 때마다 덮어쓴다.
  note     String?
  editedAt DateTime?
  editedBy String?

  /// 마지막으로 깃에서 다시 읽어온 때.
  syncedAt DateTime @default(now())

  /// 한 사람의 하루는 한 장뿐이다. 다시 맞출 때 이 짝으로 찾아 덮어쓴다.
  @@unique([authorKey, day])
  @@index([day])
}
