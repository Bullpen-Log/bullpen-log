datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}
generator client {
  provider = "prisma-client-js"
}


enum Role {
  USER
  ADMIN
}

/// 운동 영상의 출처. 직접 찍은 것과 참고용으로 걸어둔 것을 구분한다.
enum ExerciseSource {
  /// 직접 촬영해 저장소에 올린 영상
  OWN
  /// 아직 촬영 전이라 유튜브 참고 영상으로 대신하는 것
  REFERENCE
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  password          String
  nickname          String
  role              Role                @default(USER)
  /// 생년월일. 나이에 따라 안전한 투구수 한도가 달라져 투구량 조언에 필요하다.
  birthDate         DateTime?           @db.Date
  /// 키(cm). 영상에서 잰 길이를 몸 크기로 나눠 비교할 때 쓴다.
  heightCm          Int?
  /// 목표 최고 구속(km/h). 지금 구속과의 격차를 보여주는 기준이 된다.
  targetVelocity    Int?
  /// 가입 문진 — 평소 투구량. 부하 지수의 추정 기준선을 만든다. (lib/baseline.ts)
  baselineFreq      String?
  baselineVolume    String?
  baselineIntensity String?
  /// 하루 운동 시간(분). 오늘의 운동 종목 수를 이 시간에 맞춰 계산한다.
  /// 비어 있으면 기본값(lib/report/theme.ts의 DEFAULT_WORKOUT_MINUTES)을 쓴다.
  dailyWorkoutMinutes Int?
  /// 웨이트 트레이닝 경력. 어떤 난이도의 운동까지 줄지 정한다.
  /// 비어 있으면 아직 안 골랐다는 뜻이라 아무것도 빼지 않는다.
  /// 이름은 lib/report/personalize.ts의 TRAINING_LEVELS 안에서만 쓴다.
  trainingLevel     String?
  /// 훈련 목표. 구간별 시간 배분을 바꾼다. 비어 있으면 '균형 잡힌 관리'로 본다.
  /// 이름은 lib/report/personalize.ts의 TRAINING_GOALS 안에서만 쓴다.
  trainingGoal      String?
  /// 가지고 있는 운동 장비. AI 트레이닝에서 할 수 없는 운동을 빼는 데 쓴다.
  /// 비어 있으면 아직 안 골랐다는 뜻이라 아무것도 빼지 않는다.
  /// 이름은 lib/exercise-meta.ts의 EXERCISE_EQUIPMENT 안에서만 쓴다.
  ownedEquipment    String[]
  createdAt         DateTime            @default(now())

  userGuideProgress UserGuideProgress[]
  pitchLogs         PitchLog[]
  userExerciseLogs  UserExerciseLog[]
  routines          Routine[]
  articles          Article[]
  checkins          DailyCheckin[]
  aiReports         AiReport[]
}

/**
 * 생성된 AI 리포트. 한 번 만든 리포트는 그대로 보관해
 * 다시 열어도 같은 내용과 같은 근거가 보이게 한다.
 */
model AiReport {
  id           String   @id @default(uuid())
  userId       String
  /// 리포트 기준일
  asOf         DateTime @db.Date
  /// 통증 등으로 투구 계획을 내지 않은 리포트인가
  halted       Boolean  @default(false)
  haltReason   String?  @db.Text
  /// AI가 쓴 본문. 계획이 멈춘 리포트에는 없다(AI를 부르지 않음).
  body         Json?
  /// 생성 시점의 수치와 계획. 근거를 나중에도 그대로 보여주기 위해 함께 저장한다.
  facts        Json
  plan         Json
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, asOf])
  @@index([userId, asOf])
}

/// 하루 한 번 남기는 몸상태 체크인. 운동 처방과 리포트의 입력이 된다.
model DailyCheckin {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date
  /// 각 부위 느낌: 정상 / 뻐근 / 통증 (lib/checkin.ts의 CHECKIN_PARTS와 짝을 이룬다)
  shoulder  String
  elbow     String
  wrist     String   @default("정상")
  lowerBack String   @default("정상")
  lowerBody String   @default("정상")
  /// 전신 컨디션 1(안 좋음) ~ 10(최상). 높을수록 좋다.
  condition Int
  /// 수면: 충분 / 보통 / 부족
  sleep     String
  /// 오늘 하고 싶은 운동 부위. 비워두면 가리지 않는다.
  /// 안전 필터를 뚫는 값이 아니라, 통과한 후보 중 순서를 바꾸는 데만 쓴다.
  preferredParts String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model MechanicsGuide {
  id          String              @id @default(uuid())
  title       String
  category    String              @default("스로잉 드릴")
  description String              @db.Text
  /// 저장소에 올린 영상 경로. 참고 영상(REFERENCE)은 유튜브에서 재생하므로 비어 있다.
  videoPath   String?
  /// 재생 전에 보여줄 미리보기 이미지 경로. 없으면 빈 화면으로 표시한다.
  thumbPath   String?
  /// 영상 출처 — 운동(ExerciseVideo)과 같은 규칙이다.
  source           ExerciseSource @default(OWN)
  /// 참고 영상의 유튜브 영상 ID (11자). source 가 REFERENCE 일 때만 채운다.
  referenceVideoId String?
  /// 이 드릴이 무엇을 교정하는지. 영상분석 결과와 이어지는 고리다.
  focusPoints String[]
  /// 드릴에 필요한 도구
  equipment   String[]
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  progress    UserGuideProgress[]
}

model UserGuideProgress {
  userId    String
  guideId   String
  completed Boolean        @default(false)

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  guide     MechanicsGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@id([userId, guideId])
}

model PitchLog {
  id          String   @id @default(uuid())
  userId      String
  date        DateTime @db.Date
  /// 불펜 / 라이브 / 경기 / 캐치볼. 같은 투구수라도 성격이 달라 나눠 본다.
  sessionType String   @default("불펜")
  pitchCount  Int
  intensity   Int
  maxVelocity Float
  avgVelocity Float?
  memo        String?  @db.Text
  /// 그날 던진 영상의 저장소 경로. 최대 2개까지 저장한다.
  videoPaths  String[]
  createdAt   DateTime @default(now())

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  poseAnalyses  PoseAnalysis[]
}

/**
 * 폼 분석 결과. 영상 하나당 최신 분석 1개를 보관해 다시 열 때
 * 재분석 없이 바로 보여주고, 지난 세션과의 변화 비교에 쓴다.
 * 측면 촬영이 아니거나 인식이 나쁜 분석은 저장하지 않는다(비교 오염 방지).
 */
model PoseAnalysis {
  id           String   @id @default(uuid())
  userId       String
  pitchLogId   String
  /// PitchLog.videoPaths 중 어떤 영상의 분석인지
  videoPath    String   @unique
  /// 화면 표기용 좌/우투 (사용자가 전환 버튼으로 고칠 수 있음)
  throwingSide String
  /// 실제 측정에 쓴 팔 (인식 라벨 기준)
  wristSide    String
  leadSide     String
  direction    Int
  quality      Float
  coverage     Float
  /// 자동 감지된 구간 (초)
  kneeUpT      Float?
  footPlantT   Float?
  releaseT     Float?
  /// 사용자가 프레임으로 직접 보정한 구간 (초)
  kneeUpManualT    Float?
  footPlantManualT Float?
  releaseManualT   Float?
  /// 지표 배열 [{key,label,phase,value,display,reason,confidence}]
  metrics      Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pitchLog     PitchLog @relation(fields: [pitchLogId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ExerciseVideo {
  id               String            @id @default(uuid())
  title            String
  category         String
  description      String            @db.Text
  /**
   * 저장소에 올린 영상 경로 (library/... ).
   *
   * 참고 영상(source = REFERENCE)은 유튜브에서 바로 재생하므로 비어 있다.
   * 직접 촬영한 영상을 나중에 올리면 이 값이 채워지고 source 가 OWN 으로 바뀐다.
   */
  videoPath        String?
  /// 재생 전에 보여줄 미리보기 이미지 경로. 없으면 빈 화면으로 표시한다.
  thumbPath        String?
  /**
   * 영상의 출처.
   *
   * OWN       — 직접 찍어 올린 영상. videoPath 를 쓴다.
   * REFERENCE — 아직 촬영하지 않아 유튜브 참고 영상으로 대신하는 것.
   *             영상과 미리보기 모두 유튜브 주소를 가리키기만 하고
   *             우리 저장소에는 아무것도 담지 않는다.
   */
  source           ExerciseSource    @default(OWN)
  /// 참고 영상의 유튜브 영상 ID (11자). source 가 REFERENCE 일 때만 채운다.
  referenceVideoId String?
  /// 이 운동이 목표로 하는 부위
  bodyParts        String[]
  /// 매우 낮음 / 낮음 / 중간 / 높음 / 매우 높음 (lib/exercise-meta.ts)
  /// 부하가 높거나 몸이 안 좋은 날 위쪽 단계를 후보에서 빼는 데 쓴다.
  intensity        String            @default("중간")
  /// 초급 / 중급 / 상급. 선택 입력이라 비어 있을 수 있다.
  difficulty       String?
  /// 운동에 필요한 도구
  equipment        String[]
  /**
   * 처방 단위 — 몇 세트를 몇 번(또는 몇 초) 하고 얼마나 쉬는가.
   *
   * 이것이 없으면 "데드버그 하세요"까지만 알려주는 셈이라, 초보~중급자가
   * 실제로 무엇을 얼마나 해야 하는지 알 수 없다. 오늘의 운동에서 시간을
   * 어림하는 데도 쓰인다 — 예전에는 카테고리마다 정해진 값으로 어림해서,
   * 월 싯 30초와 바벨 스쿼트 5세트가 같은 시간으로 계산됐다.
   */
  sets             Int?
  /// 한 세트에 하는 횟수. 시간으로 버티는 운동은 비어 있고 holdSeconds 를 쓴다.
  reps             Int?
  /// 한 세트에 버티는 시간(초). 횟수로 하는 운동은 비어 있다.
  holdSeconds      Int?
  /// 세트 사이 쉬는 시간(초)
  restSeconds      Int?
  /// 좌우를 나눠 하는 운동인가. 그렇다면 한 세트에 양쪽을 다 한다.
  perSide          Boolean           @default(false)
  /**
   * 세부 정보(설명·강도·부위·난이도·장비)를 제대로 채운 시각.
   *
   * 비어 있으면 제목과 영상만 올린 상태로 본다. 나중에 정보를 채우는 작업을
   * 할 때 이 값이 있는 것은 건드리지 않아, 이미 손본 내용을 덮어쓰지 않는다.
   */
  detailsFilledAt  DateTime?
  createdAt        DateTime          @default(now())
  userLogs         UserExerciseLog[]
  routineExercises RoutineExercise[]
}

model UserExerciseLog {
  userId     String
  exerciseId String
  date       DateTime      @db.Date
  completed  Boolean       @default(false)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   ExerciseVideo @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([userId, exerciseId, date])
}

/**
 * 아직 화면이 없는 표.
 *
 * 운동을 "화요일 하체 루틴"처럼 묶는 기능을 하려다 표만 만들어 둔 상태다.
 * 지금은 어디에서도 읽거나 쓰지 않는다 — 찾아봐도 화면이 없으니 헤매지 말 것.
 * 메뉴 개편 5단계에서 채울 예정이라 지우지 않고 둔다.
 */
model Routine {
  id               String            @id @default(uuid())
  userId           String
  name             String
  createdAt        DateTime          @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineExercises RoutineExercise[]
}

model RoutineExercise {
  routineId  String
  exerciseId String

  routine    Routine       @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise   ExerciseVideo @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([routineId, exerciseId])
}

model Article {
  id            String   @id @default(uuid())
  userId        String
  title         String
  content       String   @db.Text
  tags          String[]
  attachmentUrl String?
  views         Int      @default(0)
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
