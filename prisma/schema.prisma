datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}
generator client {
  provider = "prisma-client-js"
}


enum Role {
  USER
  ADMIN
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  password          String
  nickname          String
  role              Role                @default(USER)
  /// 생년월일. 나이에 따라 안전한 투구수 한도가 달라져 투구량 조언에 필요하다.
  birthDate         DateTime?           @db.Date
  /// 키(cm). 영상에서 잰 길이를 몸 크기로 나눠 비교할 때 쓴다.
  heightCm          Int?
  /// 목표 최고 구속(km/h). 지금 구속과의 격차를 보여주는 기준이 된다.
  targetVelocity    Int?
  /// 가입 문진 — 평소 투구량. 부하 지수의 추정 기준선을 만든다. (lib/baseline.ts)
  baselineFreq      String?
  baselineVolume    String?
  baselineIntensity String?
  createdAt         DateTime            @default(now())

  userGuideProgress UserGuideProgress[]
  pitchLogs         PitchLog[]
  userExerciseLogs  UserExerciseLog[]
  routines          Routine[]
  articles          Article[]
  checkins          DailyCheckin[]
  aiReports         AiReport[]
}

/**
 * 생성된 AI 리포트. 한 번 만든 리포트는 그대로 보관해
 * 다시 열어도 같은 내용과 같은 근거가 보이게 한다.
 */
model AiReport {
  id           String   @id @default(uuid())
  userId       String
  /// 리포트 기준일
  asOf         DateTime @db.Date
  /// 통증 등으로 투구 계획을 내지 않은 리포트인가
  halted       Boolean  @default(false)
  haltReason   String?  @db.Text
  /// AI가 쓴 본문. 계획이 멈춘 리포트에는 없다(AI를 부르지 않음).
  body         Json?
  /// 생성 시점의 수치와 계획. 근거를 나중에도 그대로 보여주기 위해 함께 저장한다.
  facts        Json
  plan         Json
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, asOf])
  @@index([userId, asOf])
}

/// 하루 한 번 남기는 몸상태 체크인. 운동 처방과 리포트의 입력이 된다.
model DailyCheckin {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date
  /// 어깨 느낌: 정상 / 뻐근 / 통증
  shoulder  String
  /// 팔꿈치 느낌: 정상 / 뻐근 / 통증
  elbow     String
  /// 전신 컨디션 1(안 좋음) ~ 10(최상). 높을수록 좋다.
  condition Int
  /// 수면: 충분 / 보통 / 부족
  sleep     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model MechanicsGuide {
  id          String              @id @default(uuid())
  title       String
  category    String              @default("스로잉 드릴")
  description String              @db.Text
  /// 저장소에 올린 영상 경로 (library/... )
  videoPath   String
  /// 재생 전에 보여줄 미리보기 이미지 경로. 없으면 빈 화면으로 표시한다.
  thumbPath   String?
  /// 이 드릴이 무엇을 교정하는지. 영상분석 결과와 이어지는 고리다.
  focusPoints String[]
  /// 드릴에 필요한 도구
  equipment   String[]
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  progress    UserGuideProgress[]
}

model UserGuideProgress {
  userId    String
  guideId   String
  completed Boolean        @default(false)

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  guide     MechanicsGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@id([userId, guideId])
}

model PitchLog {
  id          String   @id @default(uuid())
  userId      String
  date        DateTime @db.Date
  pitchCount  Int
  intensity   Int
  maxVelocity Float
  avgVelocity Float?
  memo        String?  @db.Text
  /// 그날 던진 영상의 저장소 경로. 최대 2개까지 저장한다.
  videoPaths  String[]
  createdAt   DateTime @default(now())

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  poseAnalyses  PoseAnalysis[]
}

/**
 * 폼 분석 결과. 영상 하나당 최신 분석 1개를 보관해 다시 열 때
 * 재분석 없이 바로 보여주고, 지난 세션과의 변화 비교에 쓴다.
 * 측면 촬영이 아니거나 인식이 나쁜 분석은 저장하지 않는다(비교 오염 방지).
 */
model PoseAnalysis {
  id           String   @id @default(uuid())
  userId       String
  pitchLogId   String
  /// PitchLog.videoPaths 중 어떤 영상의 분석인지
  videoPath    String   @unique
  /// 화면 표기용 좌/우투 (사용자가 전환 버튼으로 고칠 수 있음)
  throwingSide String
  /// 실제 측정에 쓴 팔 (인식 라벨 기준)
  wristSide    String
  leadSide     String
  direction    Int
  quality      Float
  coverage     Float
  /// 자동 감지된 구간 (초)
  kneeUpT      Float?
  footPlantT   Float?
  releaseT     Float?
  /// 사용자가 프레임으로 직접 보정한 구간 (초)
  kneeUpManualT    Float?
  footPlantManualT Float?
  releaseManualT   Float?
  /// 지표 배열 [{key,label,phase,value,display,reason,confidence}]
  metrics      Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pitchLog     PitchLog @relation(fields: [pitchLogId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ExerciseVideo {
  id               String            @id @default(uuid())
  title            String
  category         String
  description      String            @db.Text
  /// 저장소에 올린 영상 경로 (library/... )
  videoPath        String
  /// 재생 전에 보여줄 미리보기 이미지 경로. 없으면 빈 화면으로 표시한다.
  thumbPath        String?
  /// 이 운동이 목표로 하는 부위
  bodyParts        String[]
  /// 낮음 / 중간 / 높음. 부하 지수가 높을 때 '높음'을 빼는 데 쓴다.
  intensity        String            @default("중간")
  /// 초급 / 중급 / 상급. 선택 입력이라 비어 있을 수 있다.
  difficulty       String?
  /// 운동에 필요한 도구
  equipment        String[]
  createdAt        DateTime          @default(now())
  userLogs         UserExerciseLog[]
  routineExercises RoutineExercise[]
}

model UserExerciseLog {
  userId     String
  exerciseId String
  date       DateTime      @db.Date
  completed  Boolean       @default(false)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   ExerciseVideo @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([userId, exerciseId, date])
}

model Routine {
  id               String            @id @default(uuid())
  userId           String
  name             String
  createdAt        DateTime          @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineExercises RoutineExercise[]
}

model RoutineExercise {
  routineId  String
  exerciseId String

  routine    Routine       @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise   ExerciseVideo @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([routineId, exerciseId])
}

model Article {
  id            String   @id @default(uuid())
  userId        String
  title         String
  content       String   @db.Text
  tags          String[]
  attachmentUrl String?
  views         Int      @default(0)
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
