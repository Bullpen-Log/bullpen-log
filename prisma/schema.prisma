datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  /// 대표관리자 — 모든 관리자 기능(2026-10-20 전 "관리자" 그대로)
  ADMIN
  /// 준관리자 — lib/permissions.ts 표가 연 기능만(영상 촬영 · 구속 측정 관리자 · 세션 녹화 · ABS)
  MANAGER
}

/// 계정 종류(2026-10-20 팀 · 레슨장 마스터) — 가입할 때 정해진다. MASTER 는 선수 기능이 없고 /master 로만 간다(lib/dal.ts requireMaster).
enum AccountType {
  PLAYER
  MASTER
  /// 덕아웃만 쓰는 회원(2026-10-21, docs/designs/sinker-dugout.md 결정 3) — 학부모 · 팬 · 코치. 레슨을 받아 첫 기록이 생기면 sinkerStartedAt 이 찍히고 싱커를 쓴다
  MEMBER
}

/// 조직 종류 — 레슨장(회원 · 레슨)과 팀(선수단 · 훈련 일정). 화면의 말과 홈이 다르다.
enum OrgKind {
  LESSON
  TEAM
}

/// 조직 안 역할 — 마스터(만든 사람) · 스태프(코치) · 선수(회원)
enum OrgRole {
  MASTER
  STAFF
  PLAYER
}

/// 구성원 상태 — 초대만 됨 · 활동 · 나감(기록은 선수 것이라 남고 조직 화면에서만 빠진다)
enum OrgMemberStatus {
  INVITED
  ACTIVE
  LEFT
}

/// 운동 영상의 출처. 직접 찍은 것과 참고용으로 걸어둔 것을 구분한다.
enum ExerciseSource {
  /// 직접 촬영해 저장소에 올린 영상
  OWN
  /// 아직 촬영 전이라 유튜브 참고 영상으로 대신하는 것
  REFERENCE
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  nickname            String
  /// 프로필 사진이 저장소에 놓인 자리(<userId>/avatar-….jpg). 안 올렸으면 비어 있다.
  /// 투구 영상과 같은 비공개 저장소에 들어가고, 볼 때마다 서명된 임시 주소를 만든다.
  avatarPath          String?
  role                Role      @default(USER)
  /// 선수 · 마스터(팀 · 레슨장 관리) — 마스터 계정은 (app) 틀이 /master 로 보낸다
  accountType         AccountType @default(PLAYER)
  /// 어느 얼굴에서 가입했나(lib/app-env.ts Surface: 'sinker-app' · 'dugout-app' · 'web') — 2026-10-21 개편 3단계
  signupSource        String    @default("web")
  /// 싱커(선수 기록)를 쓰기 시작한 때 — 선수는 가입 때, 덕아웃 회원(MEMBER)은 첫 레슨 기록이 생길 때. 비면 '내 싱커'가 안 보인다
  sinkerStartedAt     DateTime?
  /// 덕아웃 공개 프로필(/u/<닉네임>)에 보일 싱커 항목 — 'position' · 'velocity' · 'days'. 기본은 전부 숨김
  publicSinker        String[]  @default([])
  /// 생년월일. 나이에 따라 안전한 투구수 한도가 달라져 투구량 조언에 필요하다.
  birthDate           DateTime? @db.Date
  /// 성별 'M' | 'F'. 가입할 때 받고 내 정보에서 고친다. 영양 목표의 기초대사량 계산에 쓴다.
  /// 비어 있으면(이 칸이 생기기 전에 가입한 계정) 영양은 남녀 식의 가운데 값으로 셈한다.
  /// 값은 lib/profile.ts 의 SEXES 안에서만 쓴다.
  sex                 String?
  /// 키(cm). 영상에서 잰 길이를 몸 크기로 나눠 비교할 때 쓴다.
  heightCm            Int?
  /// 몸무게(kg). 소수 한 자리까지 적을 수 있어 Float 으로 둔다.
  /// 화면에서는 설정한 단위(kg·lb)로 보여주지만 여기에는 늘 kg 으로 담는다.
  weightKg            Float?
  /// 윙스팬(cm) — 양팔을 벌린 길이. 키와 함께 몸 크기를 재는 값이다.
  /// 투수는 팔이 길수록 릴리스 포인트가 앞으로 나와, 같은 구속도 다르게 느껴진다.
  wingspanCm          Float?
  /// 목표 최고 구속(km/h). 지금 구속과의 격차를 보여주는 기준이 된다.
  targetVelocity      Int?
  /// 던지는 손. 폼 분석에서 어느 팔을 보는지 정한다.
  /// 이름은 lib/baseline.ts의 THROWING_HANDS 안에서만 쓴다.
  throwingHand        String?
  /// 어디서 야구를 하는지 — 초등학교/중학교/…/사회인.
  ///
  /// 이 값으로 무엇을 강제로 바꾸지는 않는다. 나이는 생년월일로 이미 알고 있고,
  /// 안전 한도도 거기서 나온다. 나중에 "고등학교 투수들은 보통 어떤지"를 보려고
  /// 모으는 값이다. 이름은 lib/baseline.ts의 COMPETITION_LEVELS 안에서만 쓴다.
  competitionLevel    String?
  /// 가입 문진 — 평소 투구량. 부하 지수의 추정 기준선을 만든다. (lib/baseline.ts)
  baselineFreq        String?
  baselineVolume      String?
  baselineIntensity   String?
  /// 가입 문진 — 평소 웨이트 빈도. 운동 부하 지수의 추정 기준선을 만든다.
  ///
  /// 없으면 운동 지수는 28일이 쌓여야 나온다. 투구는 위 세 문항 덕에 첫날부터
  /// 나오는데 운동만 한 달을 기다리는 것은 앞뒤가 안 맞아서 함께 받는다.
  baselineWorkoutFreq String?
  /// 하루 운동 시간(분). 오늘의 운동 종목 수를 이 시간에 맞춰 계산한다.
  /// 비어 있으면 기본값(lib/report/theme.ts의 DEFAULT_WORKOUT_MINUTES)을 쓴다.
  dailyWorkoutMinutes Int?
  /// 웨이트 트레이닝 경력. 어떤 난이도의 운동까지 줄지 정한다.
  /// 비어 있으면 아직 안 골랐다는 뜻이라 아무것도 빼지 않는다.
  /// 이름은 lib/report/personalize.ts의 TRAINING_LEVELS 안에서만 쓴다.
  trainingLevel       String?
  /// 훈련 목표. 구간별 시간 배분을 바꾼다. 비어 있으면 기본 목표 '근력 향상'으로 본다.
  /// 이름은 lib/report/personalize.ts의 TRAINING_GOALS 안에서만 쓴다.
  trainingGoal        String?
  /// 목표 안에서 오늘 어느 부위를 할지. 비어 있으면 앱이 번갈아 정한다.
  ///
  /// 목표(trainingGoal)는 '같은 시간을 어디에 더 쓸까'를 정하고, 상체·하체는
  /// 앱이 최근 기록을 보고 번갈아 골라 왔다. 그런데 "오늘은 당기기만 하고
  /// 싶다"는 사람에게는 그 자동이 방해가 된다. 좁히고 싶을 때만 쓰는 값이라
  /// 비어 있는 것이 기본이고, 그때는 예전처럼 앱이 정한다.
  ///
  /// 값은 lib/report/personalize.ts의 GOAL_FOCUSES 안에서만 쓴다.
  trainingFocus       String?
  /// 가지고 있는 운동 장비. AI 트레이닝에서 할 수 없는 운동을 빼는 데 쓴다.
  /// 비어 있으면 아직 안 골랐다는 뜻이라 아무것도 빼지 않는다.
  /// 이름은 lib/exercise-meta.ts의 EXERCISE_EQUIPMENT 안에서만 쓴다.
  ownedEquipment      String[]
  /// ── 가입 · 탭별 첫 설정 · 튜토리얼(2026-10-09, docs/designs/signup-and-tab-onboarding.md — lib/feature-locks.ts). 비어 있으면 그 탭이 잠겨 있다 ──
  /// 투구 기록 첫 설정(던지는 손 · 평소 투구량 · 목표 구속)을 마친 시각. 비어 있으면 투구 기록 · 구속 측정이 잠긴다.
  pitchSetupAt        DateTime?
  /// 트레이닝 첫 설정(웨이트 경력 · 평소 웨이트 빈도 · 장비 · 하루 시간)을 마친 시각. 비어 있으면 트레이닝 · 운동 · 암케어 · 메커니즘이 잠긴다.
  trainingSetupAt     DateTime?
  /// 타격 첫 설정을 마친 시각(2026-10-20, docs/designs/hitting-restructure.md). 비어 있으면 타격 기록이 잠긴다('타격 시작하기').
  hitSetupAt          DateTime?
  /// 포지션 — 'pitcher' | 'hitter' | 'two-way'. 비면 투수로 본다(이 칸이 생기기 전 회원 모두). 값은 lib/position.ts 안에서만.
  position            String?
  /// 치는 손 — 'R' | 'L' | 'S'(스위치). 비면 모름.
  battingHand         String?
  /// 영양은 NutritionProfile 줄이 있으면 열린 것으로 본다(가입에서는 더 이상 만들지 않는다).
  /// 본 튜토리얼 — 'tour:web' | 'tour:app'(앱 기본 사용법, 웹 · 앱 따로) · 'pitch' | 'training' | 'nutrition'(탭 사용법). 값은 lib/feature-locks.ts 의 TUTORIAL_KEYS 안에서만.
  tutorialsDone       String[]  @default([])
  /// 약관 · 개인정보 처리방침에 동의한 시각(가입 때). 이 칸이 생기기 전 계정은 비어 있다.
  agreedAt            DateTime?
  /// 평소 투구량(종류별 주당 횟수) — {"catch":n,"bullpen":n,"game":n}, 0~7. 투구 기록 첫 설정이 받고, 부하 지수의 시작 기준선을 셈한다(lib/baseline.ts).
  /// 있으면 이것이 원본이고 옛 세 칸(baselineFreq · Volume · Intensity)은 비슷한 값으로 같이 적어 둔다(2026-10-11 김민: 한 주가 섞인 걸 한 칸에 못 담아서)
  baselineMix         Json?
  /// 시뮬레이션 날짜 — 시험 계정을 '그날'로 써 보려고(2026-10-11 김민). 있으면 이 계정만 서버 · 화면의 '오늘'이 이 날짜(시각은 실제), 없으면 실제 날짜. lib/clock.ts
  simDate             DateTime? @db.Date
  createdAt           DateTime  @default(now())

  exerciseFavorites UserExerciseFavorite[]
  exerciseNotes     UserExerciseNote[]
  drillFavorites    UserDrillFavorite[]
  drillLogs         UserDrillLog[]
  mechanicsProgram  MechanicsProgram?
  pitchLogs         PitchLog[]
  hittingLogs       HittingLog[]
  velocitySessions  VelocitySession[]
  velocityPitches   VelocityPitch[]
  velocityAttempts  VelocityAttempt[]
  userExerciseLogs  UserExerciseLog[]
  workoutSessions   TrainingSession[]
  articles          Article[]
  supportInquiries  SupportInquiry[]
  supportReplies    SupportReply[]    @relation("SupportReplyAuthor")
  supportNotices    SupportNotice[]   @relation("SupportNoticeAuthor")
  communityPosts    CommunityPost[]
  communityComments CommunityComment[]
  gameComments      GameComment[]
  communityLikes    CommunityLike[]
  communityReports  CommunityReport[] @relation("CommunityReporter")
  communityBlocks   CommunityBlock[]  @relation("CommunityBlocker")
  communityBlockedBy CommunityBlock[] @relation("CommunityBlocked")
  communityJoins    CommunityJoin[]
  communityMessages CommunityMessage[] @relation("CommunityMessageSender")
  communityThreads  CommunityMessage[] @relation("CommunityMessageThread")
  listings          Listing[]
  listingFavorites  ListingFavorite[]
  buyingChats       Conversation[]    @relation("ConversationBuyer")
  sellingChats      Conversation[]    @relation("ConversationSeller")
  messages          Message[]
  lessonBookings    LessonBooking[]
  lessonReviews     LessonReview[]
  venues            Venue[]
  venueBookings     VenueBooking[]
  checkins          DailyCheckin[]
  trainingSetups    DailyTrainingSetup[]
  armcareRoutines   DailyArmcare[]
  myArmcareRoutines UserArmcareRoutine[]
  orgMemberships    OrgMember[]
  ownedOrgs         Org[]             @relation("OrgOwner")
  rehabPrograms     UserRehabProgram[]
  trainingPrograms  UserTrainingProgram[]
  trainingNotes     DailyTrainingNote[]
  featuredVideos    DailyFeaturedVideo[]
  nutritionProfile  NutritionProfile?
  mealEntries       MealEntry[]
  userFoods         UserFood[]
  mealCombos        MealCombo[]
  calendarEvents    CalendarEvent[]
  mealPlans         MealPlan[]
  dailyNutrition    DailyNutrition[]
}

/// 하루 한 번 남기는 몸상태 체크인. 운동 처방과 리포트의 입력이 된다.
/// 그날 하루의 훈련 설정.
///
/// 장비는 날마다 다르다. 집에서 하는 날과 헬스장 가는 날에 쓸 수 있는 것이
/// 다른데, 프로필에 한 번 적어둔 목록만 보면 오늘 없는 기구가 계속 나온다.
/// 그래서 '가지고 있는 것'(User.ownedEquipment)과 '오늘 쓸 수 있는 것'을
/// 나눠 두고, 오늘 것은 날짜별로 여기에 남긴다.
///
/// 이 줄이 없는 날은 아직 안 고른 날이라, 가진 것을 다 쓸 수 있다고 본다.
model DailyTrainingSetup {
  id                 String    @id @default(uuid())
  userId             String
  date               DateTime  @db.Date
  /// 오늘 쓸 수 있는 장비. 이름은 lib/exercise-meta.ts의 EXERCISE_EQUIPMENT 안에서만 쓴다.
  availableEquipment String[]
  /// 만들어 둔 오늘의 운동 일정. 없으면 아직 안 만든 날이다.
  ///
  /// 화면을 열 때마다 새로 계산하지 않고 만든 것을 그대로 보여준다. 그러지 않으면
  /// 아침에 본 일정과 저녁에 본 일정이 달라진다 — 최근에 한 운동을 뒤로 미루는
  /// 규칙 때문에 새로고침만 해도 바뀔 수 있다.
  ///
  /// 다만 안전은 볼 때마다 다시 본다. 만든 뒤에 통증을 입력했다면 저장해 둔
  /// 일정이 있어도 보여주지 않는다. 모양은 lib/report/daily-plan.ts의 DailyPlan.
  plan               Json?
  generatedAt        DateTime?
  /// 오늘 하고 싶은 운동 종류(체크인 3판, 2026-10-13 — 트레이닝 탭 카드, app/actions/day-cards.ts). 파워 · 웨이트 · 회복 · "추천대로"(답했지만 앱에 맡김). null 이면 아직 안 물었다
  preferredWorkout   String?
  /// 오늘 하고 싶은 운동 부위(라이브러리 부위 이름). 안 고르면 []
  preferredParts     String[]  @default([])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

/**
 * 그날의 암케어 루틴 — 하루에 하나.
 *
 * 트레이닝의 암케어 화면에서 '오늘의 암케어 만들기'를 누르면 생긴다. 그날 몸
 * 상태(던진 날·팔 피로·투구 부하·뻐근한 곳)를 보고 회복 또는 강화 루틴을 짜서
 * 여기 둔다. 화면을 열 때마다 새로 짜지 않는 것은 운동 일정(DailyTrainingSetup)과
 * 같은 까닭이다 — 새로고침만 해도 목록이 바뀌면 안 된다.
 *
 * 체크는 여기 두지 않는다. 한 것은 운동 기록(UserExerciseLog)에 남는다 — 달력과
 * 운동별 기록에 보이고, 루틴을 다시 만들어도 한 것은 지워지지 않는다.
 * 모양은 lib/armcare/routine.ts 의 ArmcareRoutine.
 */
model DailyArmcare {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date
  plan      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

/**
 * 내 암케어 루틴 — 사용자가 운동을 직접 골라 이름을 붙여 둔 루틴 (2026-09-26).
 *
 * 맞춤 루틴(DailyArmcare)은 앱이 그날 몸 상태를 보고 하루 하나를 짜 준다. 이것은
 * 사람이 짠다 — "투구 전", "집에서"처럼 여러 개를 두고 언제든 연다. 암케어는 운동
 * 일정과 상관없이 언제든 따로 한다는 기준에서 나왔다(사용자분과 정함).
 *
 * 날짜에 매이지 않는다. 체크는 여기 두지 않고 운동 기록(UserExerciseLog)에 남는다 —
 * 맞춤 루틴과 같다. 그래서 같은 운동을 두 루틴에서 해도 오늘 한 번 한 것이다.
 *
 * items 모양: [{ exerciseId, sets }] — 적힌 차례대로 한다(lib/armcare/my-routines.ts).
 */
model UserArmcareRoutine {
  id        String   @id @default(uuid())
  userId    String
  name      String
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * 재활 프로그램 — 아픈 부위(진단 없음) 또는 병명으로 시작한다(2026-10 재활 2편).
 *
 * 진행 중인 것은 한 사람에 하나다(endedAt 이 빈 줄). 규칙은 lib/armcare/rehab.ts, 근거는 docs/rehab-guideline.md.
 * 세션마다 3문항(UserRehabSession) · 매주 확인(UserRehabWeekly)이 단계와 속도를 바꾼다. 운동 체크는 여기 두지 않고
 * 운동 기록(UserExerciseLog)에 남는다 — 암케어와 같다.
 */
model UserRehabProgram {
  id               String             @id @default(uuid())
  userId           String
  /// 아픈 부위 — lib/armcare/anatomy.ts 의 ArmcareAreaKey
  area             String
  /// 병명(lib/armcare/rehab.ts 의 REHAB_CONDITIONS 키) — 진단을 받았을 때만
  condition        String?
  /// 'mild' | 'moderate' | 'severe' — 매주 확인으로 바뀐다
  severity         String
  stage            Int                @default(1)
  stageStartedAt   DateTime           @db.Date
  /// 앞당기기로 줄인 날(그 단계 최소 기간의 절반까지). 단계를 바꾸면 0
  stageShortenDays Int                @default(0)
  /// 내 활동 두 개 [{ label }] — 매주 확인에서 몇 점인지 묻는다
  activities       Json
  startedAt        DateTime           @default(now())
  endedAt          DateTime?
  /// 'done' | 'stopped'
  endReason        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions         UserRehabSession[]
  weeklies         UserRehabWeekly[]

  @@index([userId])
}

/// 근력 · 파워 프로그램 하나(lib/program/program.ts). 진행 중(active)은 한 사람 하나 — 트랜잭션 안에서 확인하고 만든다.
/// 운동 기록은 TrainingSession(얼린 목록의 program) · UserExerciseSet 에 그대로 남는다.
model UserTrainingProgram {
  id           String    @id @default(uuid())
  userId       String
  /// lib/program/program.ts 의 ProgramKey
  programKey   String
  /// 'active' | 'done' | 'stopped'
  status       String    @default("active")
  /// 'off' | 'pre' — 시작 화면에서 고른 시즌
  season       String
  /// 다음에 할 일차(1~그 프로그램의 일수, 하나 넘으면 다 끝남 — 2026-10-07 부터 4주 프로그램은 8~12일, lib/program/program.ts totalDays)
  nextDay      Int       @default(1)
  /// 고정한 운동 — 변형 키 → 운동 id(lib/program/program.ts 의 Pinned)
  pinned       Json
  /// 건너뛴 날 수 — 일차로는 세지만 완료로는 안 센다
  skippedDays  Int       @default(0)
  /// 마지막으로 일차를 넘긴 운동의 날짜 — 간격(어제 했으면 오늘은 아님) · 쉰 기간에 쓴다
  lastDoneDate DateTime? @db.Date
  /// '그래도 오늘 할래요'를 누른 날(D24) — 그날만 쉬는 날을 넘긴다
  overrideDate DateTime? @db.Date
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  /// 'done' | 'stopped' | 'switched'
  endReason    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

/// 재활 세션 하나 — 하루 한 줄. 운동 체크는 UserExerciseLog.
model UserRehabSession {
  id        String           @id @default(uuid())
  programId String
  userId    String
  date      DateTime         @db.Date
  stage     Int
  /// 지난번 뒤 남은 통증 — 0 없었음 · 1 하다 보니 사라짐 · 2 계속 있었음
  leftover  Int
  /// 오늘 운동 중 가장 아팠던 정도 0~10
  pain      Int
  /// 'muscle' | 'sharp' | 'tingle' | 'slip'
  feel      String
  /// 그날 재활 운동 중 체크한 비율 0~1
  done      Float
  /// 'green' | 'yellow' | 'red' | 'refer'
  result    String
  /// 한 칸 낮춘 운동(아래 단계)으로 했나
  lowered   Boolean          @default(false)
  createdAt DateTime         @default(now())
  program   UserRehabProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, date])
  @@index([userId])
}

/// 재활 매주 확인 한 번.
model UserRehabWeekly {
  id         String           @id @default(uuid())
  programId  String
  userId     String
  date       DateTime         @db.Date
  stage      Int
  /// 정상 대비 % 0~100
  normalPct  Int
  /// 이번 주 가장 아팠던 정도 0~10
  worstPain  Int
  nightPain  Boolean
  /// 내 활동 두 개의 점수 [0~10, 0~10]
  activities Json
  /// 세게 던질 자신감 0~10
  confidence Int
  /// 단계 시험 결과 { kind, injured, other } — 안 했으면 null
  test       Json?
  createdAt  DateTime         @default(now())
  program    UserRehabProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
}

model DailyCheckin {
  id               String   @id @default(uuid())
  userId           String
  date             DateTime @db.Date
  /// 각 부위 느낌: 정상 / 뻐근 / 통증 (lib/checkin.ts의 CHECKIN_PARTS와 짝을 이룬다)
  shoulder         String
  elbow            String
  wrist            String   @default("정상")
  lowerBack        String   @default("정상")
  lowerBody        String   @default("정상")
  /// 전신 컨디션 1(안 좋음) ~ 10(최상). 높을수록 좋다.
  condition        Int
  /// 수면: 충분 / 보통 / 부족
  sleep            String
  /// 오늘 하고 싶은 운동 부위. 비워두면 가리지 않는다.
  /// 안전 필터를 뚫는 값이 아니라, 통과한 후보 중 순서를 바꾸는 데만 쓴다.
  preferredParts   String[]
  /// 오늘 하고 싶은 운동 종류: 파워 / 웨이트 / 회복. 비워두면 '추천대로'.
  /// 부위와 같은 성격이다 — 순서를 바꾸고 테마를 고르는 데 쓰되, 통증이 있는
  /// 날에는 무엇을 골랐든 회복으로 간다.
  preferredWorkout String?

  /// ── 상세 체크인 ──────────────────────────────────────────────
  /// 전부 고르지 않아도 된다(비어 있으면 안 적은 것). 간편 체크인은 위의 몸 상태·
  /// 컨디션·수면만 받고, 여기는 더 적고 싶은 날에만 채운다.
  /// 1~5 척도는 모두 '클수록 그 느낌이 강하다'로 읽는다(피로 5 = 몹시 피곤).

  /// 잔 시간(시간). 0.5 단위. 3판(2026-10-13)부터 안 씀 — sleepQuality 로
  sleepHours   Float?
  /// 전신 근육통 1~5 — 3판부터 안 씀(통증 · 수면 신호로 대신)
  soreness     Int?
  /// 던지는 팔의 피로 1~5 — 3판부터 묻지 않음(팔 통증 정도에서 어림, lib/checkin.ts armFatigueFromPain)
  armFatigue   Int?
  /// 오늘 잰 몸무게. 저장은 늘 kg
  bodyWeightKg Float?
  /// 끼니를 얼마나 챙겼나: 잘 먹음 / 보통 / 부족. 2026-09-30 화면에서 뺐다가 2026-10-07 간편 체크인에 되살림 —
  /// 영양 조언(lib/nutrition/advice.ts, 홈 카드)이 음식 기록 없이도 오늘 몇 g 더 먹을지 어림하는 데 쓴다.
  nutrition    String?
  /// 걸른 끼니: breakfast / lunch / dinner(lib/checkin.ts SKIPPABLE_MEALS). 영양 조언이 읽는다. 비면 안 걸렀거나 안 적음.
  skippedMeals String[] @default([])
  /// 식욕 1(거의 없음)~5(왕성). 영양 가이드가 쓴다 — 입맛이 없는 날은 적게 자주 먹게 권한다.
  appetite     Int?
  /// 던지는 일정: 오늘 등판 / 오늘 불펜 / 내일 등판 / 2~3일 뒤 / 4일 이상 뒤 / 없음 (lib/checkin.ts THROW_PLANS — 2026-10-12 여섯으로, 옛 넷 글자 그대로).
  /// 매일 운동 계획(theme.ts plannedOuting) · 근력 프로그램(program/load.ts) · 영양 가이드가 읽는다 — 투구 기록은 던진 뒤에야 생긴다.
  throwPlan    String?
  /// 그날 남기고 싶은 말
  note         String? @db.Text

  /// ── 팔 통증 안내 (2026-10 추가) ─────────────────────────────────
  /// 팔 통증 자리 — 어깨 · 팔꿈치가 '통증'인 날만. lib/armcare/anatomy.ts 의 ArmcareAreaKey 값.
  /// 그 관절이 '통증'이 아니면 저장할 때 버린다(lib/checkin.ts 의 parseArmPain).
  armPainSpots String[] @default([])
  /// 팔 통증 정도 1 던질 때만 / 2 평소 움직일 때도 / 3 가만히 있어도·밤에도. 안 고르면 null
  armPainLevel Int?
  /// 불편한 근육(2026-10-12 몸 그림): { "R:deltFront": "뻐근" | "통증" } — lib/body-spots.ts. 부위 칸(shoulder …)은 여기서 가장 센 값
  bodySpots    Json?
  /// 어젯밤 수면의 질 1~5(체크인 3판, 2026-10-13 — lib/checkin.ts SLEEP_QUALITY_LEVELS). 3판부터 sleep · sleepHours 대신 이것. 옛 기록은 null(읽을 때 어림)
  sleepQuality Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model MechanicsGuide {
  id               String              @id @default(uuid())
  title            String
  category         String              @default("스로잉 드릴")
  description      String              @db.Text
  /// 저장소에 올린 영상 경로. 참고 영상(REFERENCE)은 유튜브에서 재생하므로 비어 있다.
  videoPath        String?
  /// 재생 전에 보여줄 미리보기 이미지 경로. 없으면 빈 화면으로 표시한다.
  thumbPath        String?
  /// 영상 출처 — 운동(ExerciseVideo)과 같은 규칙이다.
  source           ExerciseSource      @default(OWN)
  /// 참고 영상의 유튜브 영상 ID (11자). source 가 REFERENCE 일 때만 채운다.
  referenceVideoId String?
  /// 영상의 가로세로 비율. 운동 영상과 같은 규칙이다(ExerciseVideo.aspectRatio).
  aspectRatio      Float?
  /// 이 드릴이 투구의 어느 요소를 키우는지 — 드리프트 · 드롭 · 상하체 분리 · 브레이크 · 몸통 회전 · 스로잉
  /// (lib/exercise-meta.ts FOCUS_POINTS, 2026-10-04). 맨 앞이 주 요소, 뒤는 보조(0~2개). 영상분석 결과와 이어지는 고리다.
  focusPoints      String[]
  /// 드릴에 필요한 도구
  equipment        String[]
  /// 단계 — 기초 / 연결 / 통합(lib/exercise-meta.ts DRILL_STAGES, 2026-10-04). 메커니즘 프로그램이 쉬운 것부터
  /// 고르는 기준이다. 비어 있으면 아직 안 정한 드릴.
  stage            String?
  /// 숨긴 시각. 비어 있으면 보이는 드릴이다. 운동(ExerciseVideo.hiddenAt)과 같은 까닭으로 지우지 않고 숨긴다 —
  /// 지우면 회원의 '했다' 기록 · 별이 같이 사라진다. 처음 숨긴 것: 파트너가 있어야 하는 둘 · 상품 이름이 남은 둘(2026-10-04).
  hiddenAt         DateTime?
  sortOrder        Int                 @default(0)
  createdAt        DateTime            @default(now())
  favorites        UserDrillFavorite[]
  drillLogs        UserDrillLog[]
}

/**
 * 오늘 이 드릴을 했다.
 * 즐겨찾기와 다른 것이다. 저쪽은 '다시 찾기 쉽게 달아 둔 별'이라 날짜가 없고,
 * 이쪽은 '그날 했다'는 기록이다. 둘을 하나로 두면 "이번 주에 드릴 몇 번 했나"를
 * 셀 수가 없다.
 * 세트나 횟수를 두지 않는다. 드릴은 앱이 "몇 번 해라"라고 정해 주는 것이
 * 아니라, 선수가 설명을 읽고 필요한 것을 골라서 하는 것이다. 우리가 아는 것은
 * '골랐다'와 '했다'까지다.
 */
model UserDrillLog {
  userId  String
  guideId String
  date    DateTime @db.Date

  /// 골라 담기만 하고 아직 안 한 상태와, 하고 나서 체크한 상태를 가른다.
  done Boolean @default(false)

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  guide MechanicsGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@id([userId, guideId, date])
  @@index([userId, date])
  // 2026-10-16 통합 검토 — 드릴을 지울 때 이어 지우기가 찾는 칸
  @@index([guideId])
}

/**
 * 투구 메커니즘 향상 프로그램 — 한 사람에 하나(2026-10-04).
 *
 * 투구 요소 여섯(드리프트 · 드롭 · 상하체 분리 · 브레이크 · 몸통 회전 · 스로잉)마다 지금 단계(기초 · 연결 · 통합)에서
 * 드릴을 하고, 드릴마다 느낌(어려움 · 적당 · 쉬움)을 누른다. 같은 요소를 '쉬움'으로 세 번 넘기면 다음 단계로 오른다
 * (lib/mechanics/program.ts). 그날 할 드릴은 앱이 이 값으로 짜고, '했다'는 UserDrillLog 에 남는다.
 *
 * progress 모양: { "드리프트": { "stage": "기초", "easy": 2 }, … } — 없는 요소는 기초 · 0.
 */
model MechanicsProgram {
  id            String    @id @default(uuid())
  userId        String    @unique
  /// 더 자주 넣을 요소 하나 — 비면 여섯을 고르게
  focus         String?
  progress      Json
  /// 마친 세션 수 — 다음 세션에 어느 요소를 넣을지 돌리는 데 쓴다
  sessionsDone  Int       @default(0)
  /// 마지막으로 세션을 마친 날
  lastSessionOn DateTime? @db.Date
  startedAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * 즐겨찾기 — 운동.
 * 앱이 골라 준 일정을 손으로 고치는 순간에 쓰는 표다. 445개 중에서 "그 운동"을
 * 다시 찾는 것이 일이라, 마음에 든 것에 별을 달아두고 운동을 더할 때 위에서
 * 바로 집는다.
 * 앱이 무엇을 고를지에는 영향을 주지 않는다. 별을 달았다고 그 운동이 더 자주
 * 나오면, 같은 운동만 반복하지 않게 텀을 두고 돌리기로 한 결정을 되돌리는 셈이다.
 * 이 표는 '찾기'에만 쓴다.
 */
model UserExerciseFavorite {
  userId     String
  exerciseId String
  createdAt  DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise ExerciseVideo @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([userId, exerciseId])
  @@index([userId])
  // 2026-10-16 통합 검토 — 운동을 지울 때 이어 지우기가 찾는 칸
  @@index([exerciseId])
}

/**
 * 운동별 내 메모 — 운동 하나에 하나.
 *
 * "그립은 한 칸 넓게", "벤치 등받이 3칸" 처럼 그 운동을 할 때마다 떠올려야
 * 하는 것을 적어 둔다. 운동 중에 쓰고 고치며, 다음에 그 운동을 할 때 운동
 * 이름 아래에 미리 떠 있고, 라이브러리의 그 운동 상세에도 보인다.
 *
 * 날짜별로 쌓지 않는다. 날마다 남기는 느낀점은 DailyTrainingNote 가 따로
 * 있고, 이쪽은 '그 운동에 대한 메모'라 고치면 덮어쓴다. 비우고 저장하면
 * 줄을 지운다 — 빈 메모를 남겨 두지 않는다.
 */
model UserExerciseNote {
  userId     String
  exerciseId String
  /// 메모 내용. 앞뒤 공백을 걷고 저장한다(lib/exercise-meta.ts 의 cleanExerciseNote).
  body       String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise ExerciseVideo @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([userId, exerciseId])
  /*
   * 운동을 지울 때 딸린 메모를 찾는 자리. 외래 키 없이 Prisma 가 대신 지우므로
   * (relationMode = "prisma") 이 칸으로 찾는 길을 따로 깔아 둔다.
   */
  @@index([exerciseId])
}

/**
 * 즐겨찾기 — 투구 드릴. 운동 쪽과 같은 뜻이고, 드릴 고르는 창에서 쓴다.
 */
model UserDrillFavorite {
  userId    String
  guideId   String
  createdAt DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  guide MechanicsGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@id([userId, guideId])
  @@index([userId])
  // 2026-10-16 통합 검토 — 드릴을 지울 때 이어 지우기가 찾는 칸
  @@index([guideId])
}

model PitchLog {
  id          String   @id @default(uuid())
  userId      String
  date        DateTime @db.Date
  /// 불펜 / 라이브 / 경기 / 캐치볼. 같은 투구수라도 성격이 달라 나눠 본다.
  sessionType String   @default("불펜")
  pitchCount  Int
  /// 던진 강도 1(가볍게) ~ 10(전력). 2026-10-12 부터 입력은 effortPct(체감 %)로 받고 이 칸엔 max(1, round(pct/10)) 를 같이 쓴다 — 옛 읽는 곳이 그대로 돌게.
  intensity   Int
  /// 체감 강도 0~100%(5 단위). 2026-10-12 트레이닝 추천 2판 D2 — '세게 던진 날' = 투구수 × 체감 강도. 옛 기록은 null(읽을 땐 intensity×10).
  effortPct   Int?
  /// 최고·평균 구속(km/h). 둘 다 없어도 된다.
  ///
  /// 스피드건이 없는 선수가 훨씬 많다. 구속을 필수로 두면 그 선수들은 기록
  /// 자체를 못 남기고, 기록이 없으면 부하 지수도 AI 트레이닝도 돌지 않아
  /// 앱이 아무 일도 못 하게 된다. 부하는 투구수 × 강도로 내므로 구속이
  /// 없어도 안전 계산은 그대로 돌아간다.
  maxVelocity Float?
  avgVelocity Float?
  memo        String?  @db.Text
  /// 그날 던진 영상의 저장소 경로. 최대 2개까지 저장한다.
  videoPaths  String[]
  /// 투구 만족도 1(아쉬움) ~ 5(만족) — 던진 뒤 스스로 매긴다. '잘 던진 날 찾기'가 체크인 · 운동 · 영양과 맞댄다.
  /// 불펜 · 라이브 · 경기만 받는다(lib/pitch-satisfaction.ts). 안 매기면 null
  satisfaction Int?
  /// 좋았던 것 · 아쉬웠던 것 — lib/pitch-satisfaction.ts 의 PITCH_CUES 값. 한 감각은 둘 중 한쪽에만
  cuesGood     String[] @default([])
  cuesBad      String[] @default([])
  createdAt   DateTime @default(now())
  /// 코치가 대신 적은 기록(2026-10-20 팀 · 레슨장) — 적은 사람(User.id)과 그 조직. 선수가 적은 것은 둘 다 null
  enteredById String?
  orgId       String?
  /// 조직 활동(OrgEvent.id)에서 나온 투구 — 코치가 일지로 적었거나 선수가 그 활동에 이은 것(2026-10-26 2단계, docs/designs/sinker-team-lesson-contract.md 3절)
  orgEventId  String?
  /// 같은 저장 요청을 다시 보내도 한 줄 — 앱 · 일지가 만든 키. 옛 줄은 null(Postgres 는 null 끼리 겹쳐도 된다)
  clientKey   String?

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  velocitySessions VelocitySession[]

  // 2026-10-16 통합 검토 — 홈 · 투구 · 트레이닝이 화면마다 [userId, date] 로 십여 번 읽는데 색인이 하나도 없어 표 전체를 훑었다
  @@unique([userId, clientKey])
  @@index([userId, date])
  @@index([orgId])
  @@index([orgEventId])
}

/**
 * 타격 기록 — 하루에 여러 줄(티배팅 따로 · 경기 따로). 2026-10-20 타격 1단계(docs/designs/hitting-restructure.md).
 * 투구 기록(PitchLog)과 같은 꼴 — 종류 · 스윙 수 · 체감 강도 · 메모 · 영상 · 만족도. 1단계는 엔진 부하에 넣지 않는다(D2).
 */
model HittingLog {
  id          String   @id @default(uuid())
  userId      String
  date        DateTime @db.Date
  /// 티배팅 / 토스 / 머신 / 라이브 / 경기 — 값은 lib/hitting-log.ts HITTING_TYPES 안에서만
  sessionType String
  /// 스윙 수(경기는 타석 수로 적어도 된다). 0~1000
  swings      Int
  /// 체감 강도 5~100%(5 단위). 안 적으면 null
  effortPct   Int?
  memo        String?  @db.Text
  /// 그날 영상의 저장소 경로. 최대 2개
  videoPaths  String[] @default([])
  /// 만족도 1(아쉬움) ~ 5(만족). 안 매기면 null
  satisfaction Int?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

/**
 * 카메라 구속 측정 — 한 번 자리를 잡고 잰 한 세션. 공은 VelocityPitch 에 하나씩.
 *
 * 저장할 때 투구 기록(PitchLog) 한 건도 같이 만든다(투구수 = 잰 공 수, 최고 · 평균 구속).
 * 기록을 지우면 세션의 연결만 끊긴다(SetNull) — 잰 값은 보정 자료라 남긴다.
 *
 * 보정식은 세션에 박아 둔다. 나중에 보정식이 바뀌어도 그때 무엇으로 계산했는지 알아야
 * 되짚을 수 있다(스피드건과 견주는 일이 이 기능의 핵심이라).
 */
model VelocitySession {
  id         String   @id @default(uuid())
  userId     String
  date       DateTime @db.Date
  pitchLogId String?
  /// 카메라 가로 화각(도) — 구속 계산의 가장 큰 변수
  fovDeg     Float
  /// 보정식: 보정값 = calScale × 카메라값 + calOffset. calPairs = 맞추는 데 쓴 스피드건 짝 수
  calScale   Float    @default(1)
  calOffset  Float    @default(0)
  calPairs   Int      @default(0)
  /// 'camera'(앱 · 웹 카메라) · 'file'(슬로모션 영상 파일)
  source     String   @default("camera")
  /// 무엇을 쟀나 — 'pitch'(투구) · 'hit'(타구)
  mode       String   @default("pitch")
  /// 카메라가 어디 — 'behind-pitcher'(투수 뒤, 공이 멀어짐) · 'behind-catcher'(포수 뒤, 공이 다가옴)
  cameraPos  String   @default("behind-pitcher")
  /// 앞에 네트가 있었나
  net        Boolean  @default(true)
  /// 잰 구속 측정 모델 버전(lib/velocity-engine/version.ts) — 옛 세션은 null
  engineVersion String?
  /// 카메라 이름 · 해상도 같은 기기 정보(있으면)
  device     String?
  memo       String?
  /// 관리자가 '정확도 보정용 저장'을 켜고 잰 세션 — 공마다 영상 클립 · 분석 자료를 남긴다
  forCalibration Boolean @default(false)
  /// 자동 감지 모드였나(false = 공마다 단추를 눌러 잼)
  autoMode       Boolean @default(true)
  /// 그때 쓴 초점거리(원본 긴 변 기준 픽셀) — 렌즈 보정값이 있으면 그것, 없으면 화각으로 구한 값
  focalPx        Float?
  /// 렌즈 보정 정보(lib/velocity-lens.ts 의 LensCalibration) — 어떤 보정으로 쟀는지 되짚을 때
  lensCal        Json?
  /// 포수 뒤일 때 카메라 → 릴리스 지점 거리(m)
  releaseDistM   Float?
  /// 투수 뒤일 때 구속을 낸 폰 → 미트 거리(m)와 그 출처 — 'tape' 줄자 · 'session-size' 세션의 공 크기 가운데 값 · 'default' 기준 20m 그대로 · 'auto' 공마다 공 크기(관리자). 2.4.0 전 세션은 비어 있다(기준 20m)
  distanceM      Float?
  distanceSource String?
  /// 원본 프레임 크기
  frameW         Int?
  frameH         Int?
  // 측정 때 고른 투구 종류 · 체감 강도(5~100%) — 2026-10-16 부터 측정은 투구 기록을 만들지 않고, 투구 탭 카드가 이 값으로 기록을 채운다
  // (사용자 결정: 구속 측정은 별개 기록, 투구 기록을 남길 때 참고만). 옛 세션은 null — 이어진 투구 기록의 칸을 본다
  sessionType    String?
  effortPct      Int?
  createdAt  DateTime @default(now())
  /// 코치가 대신 잰 세션(2026-10-20 팀 · 레슨장) — 잰 사람(User.id)과 그 조직. 선수가 잰 것은 둘 다 null
  enteredById String?
  orgId       String?

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pitchLog PitchLog?      @relation(fields: [pitchLogId], references: [id], onDelete: SetNull)
  pitches  VelocityPitch[]
  attempts VelocityAttempt[]

  @@index([userId, date])
  // 2026-10-16 통합 검토 — 투구 기록을 지울 때 이어진 세션의 pitchLogId 를 비우는(SetNull) 찾기 · 측정 → 기록 잇기
  @@index([pitchLogId])
  @@index([orgId])
}

/**
 * 구속 측정 — 공 하나.
 *
 * rawKmh 는 카메라가 낸 값(구간 평균, 보정 전), kmh 는 그때의 보정식을 거친 값이다. 화면과
 * 통계는 kmh 를 쓰고, 보정을 다시 맞출 때는 rawKmh 와 gunKmh 의 짝을 쓴다.
 */
model VelocityPitch {
  id           String   @id @default(uuid())
  sessionId    String
  userId       String
  /// 세션 안 차례(1부터)
  seq          Int
  rawKmh       Float
  kmh          Float
  errorKmh     Float    @default(0)
  /// 'high' · 'medium' · 'low'
  confidence   String   @default("medium")
  /// 릴리스 직후 구속 추정 — 구간 평균에 공기 저항만큼 되돌린 값(km/h)
  releaseKmh   Float?
  /// 릴리스 포인트 — 표적(화면 가운데)에서 좌우 · 상하로 몇 cm (오른쪽 · 위가 +)
  releaseDxCm  Float?
  releaseDyCm  Float?
  /// 카메라에서 릴리스 지점까지(m), 공이 날아간 구간(m) · 시간(초), 쓴 프레임 수 · 초당 장면 수
  releaseDistM Float?
  travelM      Float?
  durationSec  Float?
  frames       Int?
  fps          Float?
  /// 구종(직구 · 슬라이더 …, 사용자가 고른다) · 코스(1~9, 스트라이크 존 9칸) · 결과('strike' · 'ball')
  pitchType    String?
  zone         Int?
  result       String?
  /// 같이 잰 스피드건 값(km/h) — 보정 자료
  gunKmh       Float?
  memo         String?
  /// 영상 클립(저장소 경로 · 바이트 · 길이(초) · MIME · 클립 안에서 공이 던져진 시각(초)) — 모든 세션(2026-10-03 부터)
  clipPath     String?
  clipBytes    Int?
  clipSec      Float?
  clipMime     String?
  clipEventSec Float?
  /// 같은 공의 광각 카메라 영상 — 아이폰 앱이 일반 · 광각을 함께 찍을 때(설정 '광각 영상도 같이 저장'). 칸 뜻은 위 clip 과 같다.
  /// 측정은 일반 카메라로 하고 광각은 넓게 보는 기록이라, 스트라이크 존을 겹치지 않는다(화각이 다르다).
  wideClipPath String?
  wideClipBytes Int?
  wideClipSec Float?
  wideClipMime String?
  wideClipEventSec Float?
  /// 엔진이 본 자료(관측 궤적 · 분석 해상도 · 초점거리 · 맞음새 · 첫/끝 속도 …) — 영상 없이도 다시 맞춰 볼 수 있게
  analysis     Json?
  /// 자동 감지로 잡힌 공인가(false = 수동)
  autoDetected Boolean  @default(true)
  /// 보정 통계에서 뺀다(잘못 잡힌 공 · 스피드건 값이 의심스러울 때) — 관리자가 켠다
  calibExclude Boolean  @default(false)
  /// 수기 — 카메라가 재지 못한 영상(30fps · 공을 못 찾음)을 스피드건 값만 적어 올린 공. rawKmh · kmh 는 그 값의
  /// 복사라 보정 짝에 넣지 않는다. 나중에 엔진이 좋아져 그 영상을 다시 재면 값을 채우고 false 가 된다.
  manual       Boolean  @default(false)
  /// 이 값을 낸 구속 측정 모델 버전 — 다시 재서 채우면 그때 버전으로 바뀐다
  engineVersion String?
  createdAt    DateTime @default(now())

  session      VelocitySession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  calibResults VelocityCalibResult[]
  attempt      VelocityAttempt?
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sessionId, seq])
}

/**
 * 구속 측정 — 공 알림(시도) 하나. 쟀든 못 쟀든 남긴다(2026-10-12 금윤호: 빠른 공일수록 못 재는데 실패는 어디에도 안 남아 구간별로
 * 셀 수 없었다 — 엔진 2.4 0단계). 알림은 세션을 저장하기 전에 오므로 세션 · 공과는 저장할 때 잇는다(sessionId · pitchId).
 * 못 잰 공의 스피드건 값은 관리자가 여기에 적는다(gunKmh) — 관리자 날짜 폴더의 '시도' 표.
 */
model VelocityAttempt {
  id            String   @id @default(uuid())
  userId        String
  sessionId     String?
  /// 이 시도로 저장된 공 — 못 쟀거나 세션을 저장하지 않았으면 비어 있다
  pitchId       String?  @unique
  date          DateTime @db.Date
  /// 앱 카메라 시계로 알림 시각(초) · 종류('ball' 날아가는 공 · 'motion' 움직임) · 세기(앱 MotionTrigger strength)
  atSec         Float?
  kind          String
  strength      Float?
  /// 쟀나 · 못 쟀으면 거부 코드(validate.ts RejectCode) · 까닭 한 토막(analyze-distance.ts DistanceReport.why)
  ok            Boolean
  rejectCode    String?
  why           String?
  /// 엔진이 이은 공 길 장면 수 — 못 쟀어도 몇 장은 있을 수 있다(0 이면 헛알림에 가깝다)
  trackFrames   Int?
  rawKmh        Float?
  confidence    String?
  /// 관리자가 적는 스피드건 값(km/h) · 통계에서 뺄까 · 메모
  gunKmh        Float?
  excluded      Boolean  @default(false)
  memo          String?
  /// 못 잰 공의 영상 클립(보정용 저장을 켠 세션만 서버에) — 칸 뜻은 VelocityPitch 의 clip* 와 같다
  clipPath      String?
  clipBytes     Int?
  clipSec       Float?
  clipMime      String?
  clipEventSec  Float?
  /// 엔진 진단(거리 보고 · 궤적 몇 장) — 못 잰 까닭을 되짚을 때
  analysis      Json?
  engineVersion String?
  createdAt     DateTime @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  session VelocitySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  pitch   VelocityPitch?   @relation(fields: [pitchId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([date])
  @@index([sessionId])
}

/// 영상 탭에서 고른 그날의 대표 투구 영상. 홈 캘린더에서 날짜를 누르면 이 영상을 띄운다.
///
/// 하루에 하나다. 영상은 기록(PitchLog.videoPaths)에 붙어 있고 한 기록에 두 개까지,
/// 하루에 기록이 여럿일 수도 있어서 '그날의 하나'를 기록 쪽에 둘 자리가 없다.
///
/// 고르지 않은 날은 이 줄이 없다 — 그때는 그날 처음 올린 영상을 보여준다. 고른 영상을
/// 나중에 기록에서 빼도 이 줄은 남지만 쓰이지 않는다. 보여줄 때 그날 영상에 아직
/// 있는지 확인한다.
model DailyFeaturedVideo {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date
  /// PitchLog.videoPaths 가운데 하나 (저장소 경로)
  videoPath String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model ExerciseVideo {
  id               String                 @id @default(uuid())
  title            String
  category         String
  description      String                 @db.Text
  /**
   * 저장소에 올린 영상 경로 (library/... ).
   * 참고 영상(source = REFERENCE)은 유튜브에서 바로 재생하므로 비어 있다.
   * 직접 촬영한 영상을 나중에 올리면 이 값이 채워지고 source 가 OWN 으로 바뀐다.
   */
  videoPath        String?
  /// 재생 전에 보여줄 미리보기 이미지 경로. 없으면 빈 화면으로 표시한다.
  thumbPath        String?
  /**
   * 영상의 출처.
   * OWN       — 직접 찍어 올린 영상. videoPath 를 쓴다.
   * REFERENCE — 아직 촬영하지 않아 유튜브 참고 영상으로 대신하는 것.
   * 영상과 미리보기 모두 유튜브 주소를 가리키기만 하고
   * 우리 저장소에는 아무것도 담지 않는다.
   */
  source           ExerciseSource         @default(OWN)
  /// 참고 영상의 유튜브 영상 ID (11자). source 가 REFERENCE 일 때만 채운다.
  referenceVideoId String?
  /// 이 운동이 목표로 하는 부위
  bodyParts        String[]
  /**
   * 몸을 어떤 방식으로 쓰는가 — 힌지·스쿼트·런지·밀기·당기기·회전·운반.
   * bodyParts 와 다른 축이다. 저쪽은 '어느 근육을 쓰나'이고 이것은 '어떻게
   * 움직이나'다. 데드리프트와 스쿼트는 둘 다 하체지만 몸을 쓰는 방식이 다르고,
   * 트레이너가 하루 구성을 짤 때 반드시 나누는 축이 이쪽이다.
   * 없으면 왜 곤란한가. 카테고리(하체 스트렝스)만 맞으면 무엇이든 들어가서,
   * 60일 중 25일은 본운동이 무릎 계열(스쿼트·런지)만으로 채워졌다. 구속은
   * 뒤쪽 사슬 — 햄스트링과 둔근 — 에서 나오는데 그쪽이 통째로 빠지는 날이다.
   * 비어 있어도 된다. 스트레칭이나 암케어처럼 이 축으로 가를 것이 없는 운동이
   * 많다. 비면 '계열이 겹치나'를 따질 때 그냥 지나간다.
   */
  movementPattern  String?
  /// 매우 낮음 / 낮음 / 중간 / 높음 / 매우 높음 (lib/exercise-meta.ts)
  /// 부하가 높거나 몸이 안 좋은 날 위쪽 단계를 후보에서 빼는 데 쓴다.
  intensity        String                 @default("중간")
  /// 초급 / 중급 / 상급. 선택 입력이라 비어 있을 수 있다.
  difficulty       String?
  /// 운동에 필요한 도구
  equipment        String[]
  /**
   * 이 운동이 키우는 근육 — 암케어 운동에만 쓴다.
   *
   * 트레이닝 암케어 화면의 '부위별 보강'이 이 값으로 운동을 부위(어깨 후방·
   * 팔꿈치 내측 …)에 나눠 담고, 오늘의 암케어가 부위를 고르게 채운다. 근육 이름은
   * lib/armcare/anatomy.ts 의 ARMCARE_MUSCLES 안에서만 쓴다. 맨 앞이 가장 크게
   * 쓰는 근육이다. 비어 있으면 아직 안 채운 운동이다.
   */
  targetMuscles    String[]               @default([])
  /**
   * 처방 단위 — 몇 세트를 몇 번(또는 몇 초) 하고 얼마나 쉬는가.
   * 이것이 없으면 "데드버그 하세요"까지만 알려주는 셈이라, 초보~중급자가
   * 실제로 무엇을 얼마나 해야 하는지 알 수 없다. 오늘의 운동에서 시간을
   * 어림하는 데도 쓰인다 — 예전에는 카테고리마다 정해진 값으로 어림해서,
   * 월 싯 30초와 바벨 스쿼트 5세트가 같은 시간으로 계산됐다.
   */
  sets             Int?
  /// 한 세트에 하는 횟수. 시간으로 버티는 운동은 비어 있고 holdSeconds 를 쓴다.
  reps             Int?
  /// 한 세트에 버티는 시간(초). 횟수로 하는 운동은 비어 있다.
  holdSeconds      Int?
  /// 세트 사이 쉬는 시간(초)
  restSeconds      Int?
  /// 좌우를 나눠 하는 운동인가. 그렇다면 한 세트에 양쪽을 다 한다.
  perSide          Boolean                @default(false)
  /**
   * 영상의 가로세로 비율 (가로 ÷ 세로).
   * 16:9 가로면 1.78, 9:16 세로면 0.56 이다. 비어 있으면 가로(16:9)로 본다 —
   * 지금 들어 있는 참고 영상은 재보니 전부 1920x1080 이라, 비워 두면 예전과
   * 똑같이 나온다.
   * 왜 저장하나: 요즘 운동 채널은 대부분 세로 쇼츠로 찍는다. 세로 영상을 16:9
   * 틀에 넣으면 좌우가 검게 막히고, 420px 자리에서 실제 영상이 158px 로
   * 쪼그라든다. 재생기에서는 알 길이 없어(유튜브 iframe 은 크기를 안 알려준다)
   * 등록할 때 한 번 재서 적어 둔다.
   */
  aspectRatio      Float?
  /**
   * 세부 정보(설명·강도·부위·난이도·장비)를 제대로 채운 시각.
   * 비어 있으면 제목과 영상만 올린 상태로 본다. 나중에 정보를 채우는 작업을
   * 할 때 이 값이 있는 것은 건드리지 않아, 이미 손본 내용을 덮어쓰지 않는다.
   */
  detailsFilledAt  DateTime?
  /**
   * 숨긴 시각. 비어 있으면 보이는 운동이다.
   * 지우기 대신 쓴다. 운동을 지우면 그 운동을 한 모든 회원의 기록이 함께
   * 사라지고(UserExerciseLog 가 딸려 있다), 지나간 운동 부하까지 소급해서
   * 바뀐다. 어제 "부하 1.2"였던 사람이 오늘 "0.9"가 되는데 본인은 아무것도
   * 안 했다 — 관리자가 "이 영상 다시 찍어야겠다" 하고 지운 것만으로.
   * 숨기면 새 일정에는 안 나오고 지난 기록은 그대로 남는다. 관리자 화면에서
   * 언제든 되돌릴 수 있다.
   */
  hiddenAt         DateTime?
  createdAt        DateTime               @default(now())
  userLogs         UserExerciseLog[]
  favorites        UserExerciseFavorite[]
  notes            UserExerciseNote[]
  warmupItems      WarmupRoutineItem[]
  workoutSets      UserExerciseSet[]
}

model UserExerciseLog {
  userId     String
  exerciseId String
  date       DateTime @db.Date
  completed  Boolean  @default(false)

  /// 실제로 한 세트 수. 안 적었으면 null.
  ///
  /// 계획값을 미리 채워 두지 않는다. 눌러서 넘어가기는 편하지만, 실제로 한 것과
  /// 다른 숫자가 그대로 저장된다. 그 숫자로 운동 부하를 계산하므로 편한 것보다
  /// 맞는 것이 먼저다. 안 적으면 '한 것은 맞지만 얼마나 했는지는 모름'이 된다.
  setsDone        Int?
  /// 세트당 실제로 한 횟수. 시간형 운동(버티기)이면 null.
  repsDone        Int?
  /// 세트당 실제로 버틴 시간(초). 횟수형 운동이면 null.
  holdSecondsDone Int?
  /**
   * 그날 가장 무겁게 든 세트의 무게(kg). 안 적었거나 맨몸이면 null.
   * 세트마다 무게를 올리는 사람이 대부분이라(40 → 50 → 60), '실제로 든 무게'
   * 하나로는 무엇을 적어야 할지 알 수 없었다. 가장 무거웠던 세트로 못박는다 —
   * 사람이 기억하는 숫자이고, 증량을 정하는 것도 그 숫자다.
   * 부하 계산은 절대값이 아니라 '평소 내 톱세트 대비 몇 배'를 쓰므로,
   * 늘 같은 기준으로만 적으면 정확하다(lib/training-load.ts 의 weightFactor).
   * 소수를 담는다. 원판은 2.5kg 단위로 늘어난다 — 62.5를 못 적으면 실제로
   * 쓰는 무게의 절반을 못 적는 셈이다.
   */
  weightKg        Float?

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise ExerciseVideo @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([userId, exerciseId, date])
  // 2026-10-16 통합 검토 — 날짜 범위 조회(지난 운동 · 부하 · 암케어)는 기본 키(userId, exerciseId, date)로 못 좁힌다. exerciseId 는 운동을 지울 때
  // 이어 지우기(relationMode prisma — DB 외래키가 없어 Prisma 가 찾아 지운다)가 표 전체를 훑지 않게
  @@index([userId, date])
  @@index([exerciseId])
}

/**
 * 그날 운동이 어땠는지 — 하루에 하나.
 * 세트·횟수는 운동마다 다르지만, "오늘 운동이 얼마나 힘들었나"는 하루에 하나면
 * 된다. 운동 열 개에 강도를 열 번 적게 하면 아무도 안 적는다.
 * 계획(DailyTrainingSetup)과 표를 나눠 둔 이유는 성격이 달라서다. 저쪽은
 * '무엇을 할까'라 일정을 다시 만들면 통째로 덮어쓰는데, 이쪽은 '무엇을 했나'라
 * 한 번 적으면 남아야 한다. 같은 행에 두면 언젠가 함께 지워진다.
 */
model DailyTrainingNote {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date
  /// 오늘 운동 강도 1(아주 가벼움) ~ 10(전력). 투구 강도와 같은 눈금을 쓴다.
  intensity Int
  /// 그날 느낀점. 안 적어도 된다.
  memo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

/**
 * 고정 워밍업 루틴.
 * 일정을 만들 때 뽑는 것이 아니라, 미리 짜 두고 그대로 쓰는 묶음이다. 운동을
 * 시작하면 본운동에 들어가기 전에 '오늘 목적에 맞는 것 하나'와 '전신' 둘이
 * 뜬다. 한 것을 체크만 하고, 운동 시간과 운동량 계산에는 넣지 않는다.
 * kind 를 유일하게 둔다. 종류마다 하나씩만 두는 것이 이 기능의 뜻이다 —
 * 날마다 달라지는 것이 아니라 고정이라서 만든 것이다.
 */
model WarmupRoutine {
  id String @id @default(uuid())

  /// LOWER · UPPER_PUSH · UPPER_PULL · COMMON
  ///
  /// 그날 본운동의 동작 계열로 고른다. 힌지·스쿼트·런지·카프면 LOWER,
  /// 밀기면 UPPER_PUSH, 당기기면 UPPER_PULL. COMMON 은 언제나 함께 뜬다.
  /// 회복 데이에는 워밍업 자체가 없다.
  kind String @unique

  name        String
  /// 카드에 한 줄로 적히는 설명. 없어도 된다.
  description String @default("")
  sortOrder   Int    @default(0)

  /// 숨긴 시각. 지우지 않고 감춘다 — 담아 둔 운동을 잃지 않기 위해서다.
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  items WarmupRoutineItem[]
}

/**
 * 루틴 안에 담긴 운동 하나.
 * 운동 자체는 ExerciseVideo 에 '워밍업' 카테고리로 올린다. 영상·미리보기·
 * 설명·처방이 이미 다 있는 구조라, 워밍업만을 위한 것을 새로 만들지 않는다.
 */
model WarmupRoutineItem {
  routineId  String
  exerciseId String
  sortOrder  Int    @default(0)

  /// 이 루틴에서만 쓰는 안내. 비우면 운동에 적어 둔 처방을 그대로 쓴다.
  note String?

  routine  WarmupRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise ExerciseVideo @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([routineId, exerciseId])
  @@index([routineId])
  @@index([exerciseId])
}

/**
 * 운동 한 판.
 * 트레이닝 화면에서 [운동 시작]을 누르면 줄이 하나 생기고, [운동 종료]로
 * 닫힌다. 하루에 하나다 — 오후에 다시 들어오면 아침에 열어 둔 것을 이어서
 * 연다. 체감 강도를 하루 한 번만 남기는 구조(DailyTrainingNote)와 맞추기
 * 위해서다.
 */
model TrainingSession {
  id     String   @id @default(uuid())
  userId String
  /// 서버가 정한 날짜. 세트가 이 값을 베껴 써서 자정을 넘겨도 안 갈린다.
  date   DateTime @db.Date

  /// lower · upper · assist · recovery
  themeKey String

  /**
   * 시작할 때 찍어 둔 오늘의 운동 목록.
   * 얼려 두지 않으면 운동 중에 목록이 바뀐다. 실제로 바뀌는 길이 넷 있다 —
   * 홈에서 컨디션을 고치면 안전 재검사가 다시 돌고, 통증을 입력하면 목록이
   * 통째로 사라지고, 다른 탭에서 '일정 다시 만들기'를 누르면 같은 날 줄을
   * 덮어쓰고, 목록에서 운동을 빼면 그날 기록까지 지워진다.
   * 스쿼트 3세트 중에 화면에서 스쿼트가 사라지는 일을 막는다. 통증만은
   * 예외로 세션 중에도 반영해 "오늘은 여기까지"를 띄운다.
   */
  plan Json

  /// ACTIVE · FINISHED · ABANDONED
  status String @default("ACTIVE")

  /// 세션을 연 시각. 워밍업을 포함한다.
  startedAt     DateTime  @default(now())
  /**
   * 본운동에 들어간 시각.
   * 워밍업 창에서 [본운동 시작] 또는 [건너뛰기]를 누르는 순간 찍는다.
   * 종료 요약의 '운동 시간'은 이 시각부터 센다 — 워밍업은 시간 계산에
   * 넣지 않기 때문이다. 워밍업이 없는 날(회복 데이)에는 startedAt 과 같다.
   */
  mainStartedAt DateTime?
  endedAt       DateTime?

  /**
   * 마친 구간들의 운동 시간(초)을 더한 값.
   * 판은 [운동 더 하기]로 다시 열 수 있다. 다시 열면 mainStartedAt 을 새로
   * 찍는데(휴식 시계가 아까 남긴 세트부터 세지 않게), 그러면 마친 뒤
   * endedAt − mainStartedAt 은 마지막 구간만 남는다. 아침 45분 + 저녁 10분이
   * '10분'이 된다. 그래서 마칠 때마다 그 구간을 여기에 더해 둔다.
   * 워밍업은 들어가지 않는다 — mainStartedAt 부터 세기 때문이다.
   */
  activeSeconds Int @default(0)

  /// DONE · SKIPPED · null(워밍업이 없는 날)
  warmupOutcome String?
  /**
   * 체크한 워밍업 운동.
   * UserExerciseLog 에 줄을 만들지 않는다. 줄이 생기면 운동 부하·부위별 세트
   * 수·'최근에 한 운동'·달력의 개수까지 다섯 군데가 오염된다. 여기에 이름만
   * 남기고, 이 칸을 읽는 계산 파일은 하나도 없다.
   */
  warmupDoneIds String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sets UserExerciseSet[]

  @@unique([userId, date])
  @@index([userId])
}

/**
 * 세트 한 줄.
 * 한 세트를 마칠 때마다 줄이 하나 생긴다. 지금까지 쓰던 UserExerciseLog 는
 * 그대로 두고, 서버가 이 줄들에서 다시 계산해 채우는 '요약'으로 쓴다 —
 * 부하·부위별 세트 수·달력을 읽는 기존 코드가 전부 그대로 돈다.
 * setNo 를 두고 (세션, 운동, 번호)를 유일하게 묶는다. 신호가 끊겼다 다시
 * 보내도 같은 줄을 덮어쓸 뿐 두 번 쌓이지 않는다. 지우면 번호에 구멍이
 * 남지만, 화면에는 순서대로 '1세트·2세트'로 다시 매겨 보여준다.
 */
model UserExerciseSet {
  id         String   @id @default(uuid())
  sessionId  String
  /// 세션에서 베껴 온다. 이 사람의 기록만 모아 읽을 때 쓴다.
  userId     String
  exerciseId String
  /// 세션에서 베껴 온다. 자정을 넘겨도 세션 날짜 그대로다.
  date       DateTime @db.Date

  /// 1부터. 화면의 '1세트'와 같은 숫자로 시작하되, 지우면 구멍이 생긴다.
  setNo Int

  /// 실제로 든 무게(kg). 맨몸이면 없다. 0.5kg 자리까지 남긴다.
  weightKg    Float?
  /// 실제로 한 횟수. 시간형 운동이면 없다.
  reps        Int?
  /// 실제로 버틴 시간(초). 횟수형 운동이면 없다.
  holdSeconds Int?
  /// 근력 · 파워 프로그램의 '몇 개 더 할 수 있었나요?'(0~4, 4는 4개 이상). 마지막 세트에만, 안 답했으면 없다.
  rir         Int?

  /**
   * 이 세트를 마친 시각.
   * 휴식 시계가 이 값에서 지금까지를 센다. 흘러가는 숫자를 들고 있지 않고
   * 시각 하나만 두므로, 화면이 꺼졌다 켜져도 쉰 시간이 정확하다.
   */
  recordedAt DateTime @default(now())

  /// 코치가 팀 · 레슨장에서 대신 남긴 세트(2026-10-26 3단계 준비) — 남긴 사람(User.id)과 그 조직 활동(OrgEvent.id). 선수가 한 세트는 둘 다 null.
  /// 선수의 그날 판에 붙고(없으면 themeKey 'org' 판을 만든다) 요약 · 부하는 지금처럼 세트에서 셈한다. 세트 번호는 101 부터라 선수 세트와 안 겹친다.
  enteredById String?
  orgEventId  String?

  session  TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise ExerciseVideo   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([sessionId, exerciseId, setNo])
  @@index([sessionId])
  @@index([userId, date])
  @@index([exerciseId])
  @@index([orgEventId])
}

model Article {
  id            String   @id @default(uuid())
  userId        String
  title         String
  content       String   @db.Text
  tags          String[]
  attachmentUrl String?
  views         Int      @default(0)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 2026-10-16 통합 검토 — 탈퇴 때 이어 지우기가 찾는 칸
  @@index([userId])
}

/// 관리자가 공용 내용을 바꿀 때마다 한 줄씩 쌓이는 기록 — '패치노트'.
///
/// 같이 쓰는 것(운동 라이브러리·드릴 가이드·자료실)은 한 사람이 바꾸면 모두에게
/// 바뀐다. 그런데 무엇이 언제 왜 바뀌었는지 남는 곳이 없어서, 나중에 "이 운동
/// 설명 누가 고쳤지"를 물을 데가 없었다. 바뀌는 순간 자동으로 적는다.
///
/// 회원을 지워도 기록은 남아야 하므로 이름을 문자열로 함께 박아 둔다(authorName).
/// 관계로만 두면 탈퇴한 사람이 한 일이 통째로 사라진다.
/// 패치노트 — 프로그램을 고친 기록.
///
/// 한 장이 '누가 · 어느 날'이다. 그 사람이 그날 한 커밋을 전부 모아 한 장으로
/// 둔다. 커밋 하나하나를 한 장씩 두면 하루에 열 장씩 쌓여 무엇이 큰 일이었는지
/// 안 보이고, 사람 구분 없이 날짜로만 묶으면 둘이 같은 날 작업했을 때 누구 것인지
/// 섞인다.
///
/// 내용은 깃 기록에서 가져온다. 손으로 적는 것이 아니라 scripts/sync-patch-notes.mjs
/// 가 커밋을 읽어 채운다 — 적는 것을 잊어버릴 수 있는 자리를 아예 없앤다.
model PatchNote {
  id String @id @default(uuid())

  /// 고친 날. 'YYYY-MM-DD' 글자다.
  ///
  /// DateTime 을 쓰지 않는 이유는 시간대다. 날짜만 필요한데 시각을 함께 두면
  /// 보는 곳에 따라 하루가 밀린다 — 밤 늦게 한 작업이 다음 날로 넘어간다.
  day String

  /// 누가. 이름은 바뀔 수 있어서 묶는 열쇠는 메일 주소로 따로 둔다.
  authorKey  String
  authorName String

  /// 그날 그 사람의 커밋들.
  /// [{ sha, subject, body, files, insertions, deletions }]
  commits Json

  /// 한눈에 보는 크기. 목록에서 '큰 작업이었나'를 가늠하는 몫이다.
  commitCount  Int @default(0)
  filesChanged Int @default(0)
  insertions   Int @default(0)
  deletions    Int @default(0)

  /// 어디를 건드렸나 — '홈 화면', '데이터베이스' 처럼 사람 말로.
  /// 경로에서 자동으로 뽑는다. 같이 하는 사람이 제목만 보고 넘길지
  /// 열어볼지 정하는 데 쓴다.
  areas String[]

  /// 사람이 덧붙이는 글. 커밋 제목이 못 담는 '왜'를 적는 자리다.
  /// 여기만 사람이 고친다. 나머지는 다시 맞출 때마다 덮어쓴다.
  note     String?
  editedAt DateTime?
  editedBy String?

  /// 마지막으로 깃에서 다시 읽어온 때.
  syncedAt DateTime @default(now())

  /// 한 사람의 하루는 한 장뿐이다. 다시 맞출 때 이 짝으로 찾아 덮어쓴다.
  @@unique([authorKey, day])
  @@index([day])
}

// ── 영양 ─────────────────────────────────────────────────────────
//
// 영양 탭(app/(app)/nutrition)의 기록. 다이어트 앱 '인아웃'의 흐름(끼니별 기록,
// 먹은 칼로리와 쓴 칼로리, 탄단지 게이지)을 투수에게 맞춰 가져왔다.
// 계산은 lib/nutrition/ 에 있다.

/// 영양 목표 — 한 사람에 한 줄.
///
/// 하루 칼로리·탄단지 목표는 저장하지 않고, 이 값과 가입 정보(키·몸무게·나이)로
/// 그때그때 계산한다. 체중이 바뀌면 목표도 따라 바뀌어야 하기 때문이다.
model NutritionProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  // 옛 성별 칸(sex)을 스키마에서 뺐다(2026-10-03, 1단계) — 성별은 계정(User.sex)에 있다. DB 의 칸은 아직 남아 있고,
  // 이 코드가 배포된 뒤 마이그레이션으로 지운다(2단계). 그 사이 migrate diff 를 돌리면 DROP COLUMN "sex" 가 따라 나온다 —
  // 그 줄은 금윤호가 2단계로 따로 올리니 빼고 쓴다(HANDOFF.md).
  /// 'gain' 증량 · 'maintain' 유지 · 'lose' 감량
  goal         String   @default("maintain")
  /// 운동을 뺀 평소 움직임: 'low' · 'mid' · 'high'. 운동은 그날 기록으로 따로 더한다.
  activity     String   @default("mid")
  /// 체중 1kg 당 단백질(g). 선수 권장 범위는 1.6~2.2.
  proteinPerKg Float    @default(1.8)
  /// 직접 정한 하루 칼로리(운동 전). 있으면 계산값 대신 쓴다.
  kcalTarget   Int?
  /// ── 체중 목표(영양 로드맵 4번 — lib/nutrition/weight-goal.ts). 넷 다 비면 목표 숫자는 예전과 같다 ──
  /// 목표 체중(kg, 0.1 단위). 증량(성장기 · 성인) · 감량(성인)일 때만 있다. 비면 속도만 본다.
  targetWeightKg Float?
  /// 고른 주당 속도(kg/주, 크기만 — 방향은 goal). null = 나이별 기본 속도(예전 goalDelta 와 같은 kcal).
  weeklyRateKg Float?
  /// 체중 흐름을 보고 단추로 받아들인 하루 칼로리 조정(100 단위). null = 0. 서버만 쓴다.
  kcalAdjust   Int?
  /// 지금 칼로리 계획이 시작된 날(목표 · 속도 · 평소 움직임 · 직접 칼로리 · 조정이 바뀐 날). 판정 구간의 시작.
  planSince    DateTime? @db.Date
  /// 직접 정한 하루 단백질(g). 있으면 체중 × 1kg 당 g 대신 쓴다(지방 · 탄수화물은 그 뒤로 계산).
  proteinTargetG   Float?
  /// ── 목표 구체화 · 식단 짜기(lib/nutrition/diet-prefs.ts). 비어 있으면 식단 짜기가 기본값으로 짠다 ──
  /// 목표 날짜 — 이때까지 목표 체중에 닿고 싶다. 비면 기간 없이 속도로만 본다.
  goalEndDate      DateTime? @db.Date
  /// 시즌 단계: 'off' 비시즌 · 'pre' 시즌 준비 · 'in' 시즌 중 · 'rehab' 재활
  seasonPhase      String?
  /// 식단 스타일: 'korean' 한식 위주 · 'mixed' 골고루 · 'simple' 간편식 위주
  dietStyle        String?
  /// 끼니 구성: '3' 세 끼 · '3+1' 세 끼 + 간식 · '3+2' 세 끼 + 간식 둘 · '2+1' 두 끼 + 간식
  mealPattern      String?
  /// 못 먹거나 안 먹는 것 — lib/nutrition/diet-prefs.ts 의 AVOIDS 열쇠
  avoidFoods       String[]  @default([])
  /// 단백질 쉐이크 · 바 같은 보충식품을 식단에 넣어도 되나
  allowSupplements Boolean   @default(true)
  /// ── 인아웃식 온보딩(2026-10-08, docs/designs/inout-onboarding.md ④ — lib/nutrition/onboarding.ts). 넷 다 비면 예전과 같다 ──
  /// 목표 카드의 원답: 'gain' 증량 · 'muscle' 근육 키우기 · 'maintain' 유지 · 'lose' 감량 · 'lean' 군살만 빼기. 계산은 goal · proteinPerKg 로 접은 값만 본다.
  goalKind         String?
  /// 탄단지 나누기(지방 몫): 'balanced' 25% · 'carb' 20% · 'protein' 25% + 단백질 2.0g/kg. 비면 균형(지금 숫자 그대로).
  macroPreset      String?
  /// 직접 정한 하루 지방(g, 20~200). 있으면 지방 몫 대신 쓴다(탄수화물은 그 뒤로 계산).
  fatTargetG       Float?
  /// 온보딩(가입 또는 /nutrition/setup)을 끝낸 시각. 비면 옛 계정 · 아직 안 함 — 영양 탭이 시작하기를 권한다.
  onboardedAt      DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// 먹은 음식 한 줄.
///
/// 음식의 이름과 1인분 영양소를 이 줄에 적어 둔다(찍어 두기). 음식 목록의 값이
/// 나중에 고쳐지거나 식약처 자료가 바뀌어도 지난 기록은 그대로여야 한다.
/// 먹은 양(amount)을 고치면 1인분 값에 곱해 다시 셈한다.
model MealEntry {
  id           String   @id @default(uuid())
  userId       String
  date         DateTime @db.Date
  /// 'breakfast' · 'lunch' · 'dinner' · 'snack'
  meal         String
  name         String
  /// 어디서 온 음식인가: 'basic'(앱 기본 목록) · 'mfds'(식약처) · 'mine'(내 음식) · 'free'(자유 입력)
  source       String
  /// 원래 음식의 열쇠(기본 목록 key · 식약처 식품코드 · UserFood id). 자유 입력은 비어 있다.
  sourceId     String?
  /// 1인분을 사람 말로 — '1공기(210g)'
  servingLabel String?
  /// 1인분의 그램. 모르면 비어 있다.
  servingGrams Float?
  /// 먹은 양(인분). 반 공기 = 0.5
  amount       Float    @default(1)
  /// 1인분 값. 먹은 양 전체는 amount 를 곱한다.
  kcal         Float
  carbs        Float?
  protein      Float?
  fat          Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

/// 내 음식 — 직접 만든 음식과 즐겨찾기한 음식.
///
/// 즐겨찾기도 값을 여기로 옮겨 둔다. 식약처에 매번 다시 묻지 않아도 되고,
/// 원래 목록에서 사라져도 내 것은 남는다.
model UserFood {
  id           String   @id @default(uuid())
  userId       String
  name         String
  /// 'mine'(직접 만듦) · 'basic' · 'mfds'(여기서 즐겨찾기함)
  source       String   @default("mine")
  sourceId     String?
  servingLabel String
  servingGrams Float?
  /// 1인분 값
  kcal         Float
  carbs        Float?
  protein      Float?
  fat          Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// 자주 먹는 조합 — 여러 음식을 한 묶음으로 저장해 두고 한 번에 담는다(영양 로드맵 6번).
///
/// 음식 값은 MealEntry 처럼 찍어 둔다(items). 원래 음식이 고쳐지거나 지워져도 조합은 그대로다.
/// 줄 모양은 lib/nutrition/combos.ts 의 ComboItem — 읽을 때 그 파일이 하나씩 다시 본다.
model MealCombo {
  id         String    @id @default(uuid())
  userId     String
  name       String
  /// 저장한 끼니('breakfast' · 'lunch' · 'dinner' · 'snack') — 그 끼니 창에서 먼저 보인다. 다른 끼니에도 담을 수 있다
  meal       String?
  /// 음식들 — [{ source, sourceId, name, servingLabel, servingGrams, kcal, carbs, protein, fat, amount }]
  items      Json
  /// 담은 횟수와 마지막으로 담은 때 — 자주 쓰는 조합을 위로
  useCount   Int       @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// 짜 준 하루 식단(lib/nutrition/meal-plan.ts). 먹은 기록(MealEntry)과 따로 둔다 — 계획은 먹기 전이라 먹은 칼로리 ·
/// 체중 흐름 판정에 섞이면 안 된다. 계획 줄을 '먹었어요'로 누르면 그때 MealEntry 가 생기고 그 줄은 먹은 것으로 표시된다.
model MealPlan {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date
  /// 끼니별 음식과 먹었는지 — lib/nutrition/meal-plan.ts 의 PlanItem[]
  items     Json
  /// 짤 때 쓴 조건(오늘 장소 · 더위 · 다시 짠 횟수 · 까닭) — lib/nutrition/meal-plan.ts 의 PlanContext
  context   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

/// 하루의 체중 — 영양 탭에서 적는다.
///
/// 체중은 상세 체크인에도 적을 수 있다(DailyCheckin.bodyWeightKg). 영양 탭은
/// 이 줄을 먼저 보고, 없으면 그날 체크인의 값을 쓴다. 체크인 줄은 어깨·컨디션
/// 같은 필수 칸이 있어서 체중만 따로 넣을 수 없다.
///
/// 물 기록(waterMl)과 물 목표(NutritionProfile.waterGoalMl)는 영양 탭에서 물을 빼며
/// 지웠다(2026-09-25).
model DailyNutrition {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date
  weightKg  Float?
  /// 오늘 식욕 1~5(체크인 3판, 2026-10-13 — 영양 탭 카드, lib/checkin.ts APPETITE_LEVELS). 2판까지는 DailyCheckin.appetite
  appetite  Int?
  /// 끼니 양(lib/checkin.ts MEAL_AMOUNTS — 잘 먹음 · 보통 · 부족). 2판까지는 DailyCheckin.nutrition
  mealAmount String?
  /// 걸른 끼니(SKIPPABLE_MEALS 의 key). 2판까지는 DailyCheckin.skippedMeals
  skippedMeals String[] @default([])
  /// 영양 탭 카드에 답한 때 — null 이면 아직 안 물었다(아무것도 안 고른 답과 가른다). 서버가 appNow() 로 적는다
  answeredAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

/// 보정 재측정 한 차례 — 어느 날의 영상들을 그때의 모델로 다시 잰 것(구속 측정 관리자 › 보정 폴더).
/// 같은 날을 여러 번 재면 pass 가 1 · 2 · 3 으로 는다. 원본 공은 그대로고 결과만 따로 쌓인다.
model VelocityCalibRun {
  id            String   @id @default(uuid())
  /// 다시 잰 공들의 날짜(원본 세션의 날짜)
  date          DateTime @db.Date
  /// 그날의 몇 번째 보정인가(1부터)
  pass          Int
  /// 그때의 구속 측정 모델 버전
  engineVersion String
  /// 돌린 관리자
  userId        String
  memo          String?
  createdAt     DateTime @default(now())

  results VelocityCalibResult[]

  @@index([date])
}

/// 보정 재측정에서 공 하나의 결과 — 재지 못했으면 reject 에 까닭, 쟀으면 값
model VelocityCalibResult {
  id          String  @id @default(uuid())
  runId       String
  pitchId     String
  ok          Boolean
  rawKmh      Float?
  releaseKmh  Float?
  errorKmh    Float?
  confidence  String?
  frames      Int?
  fps         Float?
  /// 거부 까닭(validate.ts 의 RejectCode) — ok 가 false 일 때
  reject      String?

  run   VelocityCalibRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  pitch VelocityPitch    @relation(fields: [pitchId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([pitchId])
}

/**
 * 구속 측정 — 엔진 개발용 녹화(관리자). 측정 없이 찍은 원본 영상이다(2026-10-03 사용자: "밖에서 하나도 안 쟀다 — 왜 안 됐는지
 * 알려면 측정이 안 돼도 영상을 찍게"). 저장소가 파일 하나 50MB 라 30초 남짓 조각(VelocityRecordingPart)으로 겹쳐 찍어 올린다.
 * 관리자가 구속 측정 관리자에서 공마다 범위를 잡아 스피드건 값을 적는다(VelocityRecordingCut). 사용자 보정식에는 섞지 않는다.
 */
model VelocityRecording {
  id          String   @id @default(uuid())
  /// 찍은 관리자
  userId      String
  /// 찍은 날(한국 날짜) — 탐색기 폴더
  date        DateTime @db.Date
  /// 'recording'(찍는 중 · 끊김) · 'done'(멈춤 단추로 끝냄)
  status      String   @default("recording")
  /// 처음 조각 시작부터 마지막 조각 끝까지(초)
  durationSec Float?
  /// 카메라 · 설정(라벨 · 크기 · fps · 화각 · 렌즈 보정 · 카메라 위치 · 네트 · 존 · 형식 · 비트레이트 · 모델 버전)
  meta        Json?
  memo        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parts VelocityRecordingPart[]
  cuts  VelocityRecordingCut[]

  @@index([userId, date])
  @@index([date])
}

/// 녹화 조각 하나 — 저장소 파일 하나. 앞 조각과 몇 초 겹친다(공 하나가 조각 사이에 걸려도 어느 한 조각에 다 들어가게)
model VelocityRecordingPart {
  id          String   @id @default(uuid())
  recordingId String
  /// 0부터
  index       Int
  path        String
  bytes       Int
  mime        String
  /// 녹화 시작에서 이 조각이 시작한 때(초)
  offsetSec   Float
  durationSec Float?
  createdAt   DateTime @default(now())

  recording VelocityRecording      @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  cuts      VelocityRecordingCut[]

  @@unique([recordingId, index])
}

/// 녹화에서 잘라 낸 공 하나 — 파일을 자르지 않고 조각 안의 범위(초)만 적는다. 다시 잴 때 그 범위만 엔진에 넘긴다
model VelocityRecordingCut {
  id          String    @id @default(uuid())
  recordingId String
  partId      String
  /// 조각 파일 안의 시작 · 끝(초)
  startSec    Float
  endSec      Float
  /// 손에서 떠난 때(초, 조각 파일 기준) — 표시한 자리
  eventSec    Float?
  /// 스피드건 값(km/h)
  gunKmh      Float?
  /// 구종 키(lib/velocity-meta.ts)
  pitchType   String?
  memo        String?
  /// 보정 통계에서 뺄까
  excluded    Boolean   @default(false)
  /// 마지막으로 잰 값 — 재지 못했으면 ok false · reject 에 까닭
  ok          Boolean?
  rawKmh      Float?
  releaseKmh  Float?
  errorKmh    Float?
  reject      String?
  engineVersion String?
  measuredAt  DateTime?
  analysis    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  recording VelocityRecording     @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  part      VelocityRecordingPart @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([recordingId])
  @@index([partId])
}

/**
 * 사람이 찍은 공 자리(공 감지 학습 모델 2판 자료, services/velocity-detector/pull-labels.mjs 가 내려받는다).
 * 녹화 컷(VelocityRecordingCut) 또는 측정 클립(VelocityPitch) 하나에 하나 — 관계를 걸지 않고 target 글자로 가리킨다(원본이 지워지면 줄만 남는다).
 */
model VelocityBallLabel {
  id        String   @id @default(uuid())
  /// 'cut:<VelocityRecordingCut.id>' 또는 'pitch:<VelocityPitch.id>'
  target    String   @unique
  /// 영상 원본 크기(px) — 공 좌표의 기준
  sourceW   Int
  sourceH   Int
  /// [{ t, ball }] — t 는 조각 · 클립 파일의 시각(초), ball 은 [x, y, 지름](원본 px) 또는 null(공 없는 장면)
  frames    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// ── 고객센터(2026-10-17 1판 — 틀) ──────────────────────────────────────────────

/// 1:1 문의의 상태 — 접수됨 → 운영자가 답하면 답변 완료 → 쓴 사람 · 운영자가 닫으면 종료(lib/support.ts INQUIRY_STATUS)
enum InquiryStatus {
  OPEN
  ANSWERED
  CLOSED
}

/// 공지 — 운영자가 쓴다. pinned 는 맨 위 고정.
model SupportNotice {
  id        String   @id @default(uuid())
  authorId  String?
  title     String
  body      String   @db.Text
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 글쓴 관리자가 지워져도 공지는 남는다(SetNull, 2026-10-17 — Cascade 였을 때 계정과 함께 사라졌다)
  author User? @relation("SupportNoticeAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([pinned, createdAt])
  @@index([authorId])
}

/// 1:1 문의 — 쓴 사람과 운영자가 답글(SupportReply)을 주고받는다. category 는 lib/support.ts INQUIRY_CATEGORIES 의 key.
model SupportInquiry {
  id        String        @id @default(uuid())
  userId    String
  category  String
  title     String
  body      String        @db.Text
  status    InquiryStatus @default(OPEN)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies SupportReply[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// 문의의 답글 — fromStaff 가 참이면 운영자의 답.
model SupportReply {
  id        String   @id @default(uuid())
  inquiryId String
  authorId  String?
  fromStaff Boolean  @default(false)
  body      String   @db.Text
  createdAt DateTime @default(now())

  inquiry SupportInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  /// 답글 쓴 사람이 지워져도 대화는 남는다(SetNull) — 운영자 답이 사라지면 '답변 완료'인데 답이 없는 문의가 됐다
  author  User?          @relation("SupportReplyAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([inquiryId, createdAt])
  @@index([authorId])
}

// ── 커뮤니티(2026-10-17 1판 — 틀) ──────────────────────────────────────────────

/// 글 — category 는 lib/community.ts POST_CATEGORIES 의 key. hiddenAt 은 운영자가 가린 때(신고 처리) — 목록 · 상세에서 안 보인다.
model CommunityPost {
  id        String    @id @default(uuid())
  userId    String
  /// 게시판 — free · question · meetup · team(lib/community.ts POST_CATEGORIES)
  category  String
  /// 말머리 — 게시판마다 다름(lib/community.ts POST_TAGS)
  tag       String?
  title     String
  body      String    @db.Text
  /// 사진 · 영상 경로(비공개 저장소 {userId}/community/…), 4개까지
  media     String[]  @default([])
  /// 질문 · 답변의 채택 답변(댓글 id) — 있으면 '해결됨'
  acceptedCommentId String?
  /// 싱커 기록 카드(구속 · 3D · 기록 갱신 · 투구 영상) — 글 쓸 때 찍어 둔 값
  card      Json?
  /// 번개 · 팀 홍보 · 선수 모집 양식(언제 · 어디 · 몇 명 · 실력 · 회비 …)
  form      Json?
  /// 우리 동네 거르기(시 · 도 + 시 · 군 · 구 한 줄)
  region    String?
  /// 번개 날짜 · 시각 — 지나면 목록에서 내려가고 다음 날 대화방이 닫힌다
  meetAt    DateTime?
  /// 마감(글쓴이가 닫거나 다 참) — 더 참가 · 신청을 안 받는다
  closedAt  DateTime?
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments CommunityComment[]
  likes    CommunityLike[]
  reports  CommunityReport[]
  joins    CommunityJoin[]
  messages CommunityMessage[]

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([userId])
}

model CommunityComment {
  id        String    @id @default(uuid())
  postId    String
  userId    String
  body      String    @db.Text
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())

  post    CommunityPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports CommunityReport[]

  @@index([postId, createdAt])
  @@index([userId])
}

/// 좋아요 — 한 사람이 한 글에 한 번.
model CommunityLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

/// 사용자 차단 — 막은 사람의 글 · 댓글이 내 화면에서 안 보인다(상대는 모른다)
model CommunityBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("CommunityBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("CommunityBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

/// 번개 참가 · 팀 신청 — 한 사람이 한 글에 한 번
model CommunityJoin {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

/// 글에 묶인 대화 — 번개는 글쓴이 + 참가자 한 방(threadUserId 없음), 팀은 신청자마다 글쓴이와 둘만(threadUserId = 신청자)
model CommunityMessage {
  id           String   @id @default(uuid())
  postId       String
  threadUserId String?
  senderId     String
  body         String   @db.Text
  createdAt    DateTime @default(now())

  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  thread User?         @relation("CommunityMessageThread", fields: [threadUserId], references: [id], onDelete: Cascade)
  sender User          @relation("CommunityMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([postId, threadUserId, createdAt])
  @@index([threadUserId])
  @@index([senderId])
}

/// 신고 — 글 또는 댓글 하나(둘 중 하나만 채운다). reason 은 lib/community.ts REPORT_REASONS 의 key. resolvedAt 은 운영자가 처리한 때.
model CommunityReport {
  id         String    @id @default(uuid())
  reporterId String
  postId     String?
  commentId  String?
  /// 덕아웃 장터 물건 신고(2026-10-20) — 글 · 댓글과 같은 표에 둔다(관리자 화면 하나)
  listingId  String?
  reason     String
  detail     String?   @db.Text
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  reporter User              @relation("CommunityReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  /* 글 · 댓글이 지워져도 신고 기록은 남는다(SetNull) — 관리자 화면이 '이미 지워졌어요'로 보인다 */
  post     CommunityPost?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  comment  CommunityComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  listing  Listing?          @relation(fields: [listingId], references: [id], onDelete: SetNull)

  /* 같은 사람이 같은 글 · 댓글 · 물건을 두 번 신고하지 못하게(NULL 은 서로 다른 값으로 친다) */
  @@unique([reporterId, postId])
  @@unique([reporterId, commentId])
  @@unique([reporterId, listingId])
  @@index([listingId])
  @@index([resolvedAt, createdAt])
  @@index([reporterId])
}

// ── 트레이닝 영상 촬영(관리자) ───────────────────────────────────────────────

/**
 * 트레이닝 영상 촬영 체크 — 유튜브 참고 영상으로 대신하던 운동을 우리 영상으로 찍었나(관리자 /admin/shoot).
 *
 * 계획(주차 · 자리 · 순서)은 lib/shoot/plan-data.json 에 고정돼 있고, 여기에는 운동마다 한 줄로 상태만 남긴다. 주차가 아니라
 * 운동에 붙는다 — 다음 주로 미뤄 찍어도 같은 줄이다. 줄이 없으면 아직 안 찍은 것(대기). 되돌리기는 줄을 지운다.
 * User · ExerciseVideo 관계는 걸지 않는다(VelocityRecording 과 같이 id 만) — 운동을 지우면 계획에서도 빠지고 이 줄은 남아도 읽히지 않는다.
 */
model ShootCheck {
  id         String   @id @default(uuid())
  /// ExerciseVideo.id — 운동 하나에 하나
  exerciseId String   @unique
  /// 'done' 찍음 · 'redo' 다시 찍어야 함 · 'later' 미룸(lib/shoot/progress.ts)
  status     String   @default("done")
  /// 짧은 메모 — '초점 나감 · 다시' 같은 것
  note       String?
  /// 체크한 관리자(User.id)
  userId     String
  /// 상태를 마지막으로 바꾼 때 — 날별 촬영 속도 · 계획 대비를 이 시각으로 센다
  checkedAt  DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([checkedAt])
}

/// 홈 캘린더의 일정(app/(app)/today) — 사용자가 직접 적는 앞날 · 지난날 할 일. 투구 기록 캘린더(/videos)에는 안 나온다.
model CalendarEvent {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date
  title     String
  /// 'HH:MM' — 비우면 하루 종일
  time      String?
  memo      String?
  /// 몇 분 전에 알릴까(0 = 그 시각) — 하루 종일 일정은 그날 오전 9시 기준. null 이면 알림 없음(lib/calendar-event.ts)
  remindMin Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

/*
 * ─────────────────────────── 팀 · 레슨장 마스터(2026-10-20, docs/designs/team-lesson-build-prompt.md) ───────────────────────────
 *
 * 조직(Org)은 마스터 계정이 가입하면서 하나 만든다. 선수는 초대 코드(OrgInvite)로 들어와 구성원(OrgMember)이 되고, 무엇을 보여 줄지
 * (ShareConsent)를 스스로 정한다. 코치가 아직 가입 안 한 회원을 대신 적어 두는 자리는 userId 가 null 인 구성원이다 — 나중에 그 사람이
 * 초대 코드로 가입하면 그 줄을 이어받는다. 관계는 relationMode = "prisma" 라 DB 외래키가 없다 — 찾는 칸마다 색인을 둔다.
 */

/// 레슨장 · 팀 하나
model Org {
  id        String   @id @default(uuid())
  kind      OrgKind
  name      String
  /// 지역 — 자유 글(예: 서울 강남)
  region    String?
  /// 레슨장 주소 · 지도 자리(덕아웃 지도, 2026-10-24) — 좌표는 저장할 때 카카오 주소 검색으로
  address   String?
  lat       Float?
  lng       Float?
  /// 짧은 메모 — 레슨장은 코치 수, 팀은 연령대 · 리그
  note      String?
  /// 만든 마스터 계정
  ownerId   String
  /// 요금제 · 자리 수 · 메모 — 결제 연동 전(결정 8 · 9: 나중에)이라 관리자가 손으로 적는다. plan 은 'free' · 'studio' · 'team' 같은 자유 글
  plan      String?
  seats     Int?
  planNote  String?
  /// 덕아웃 레슨 예약(2판, 2026-10-21) — 코치 프로필을 공개하면 비교 목록에 뜬다. 레슨장(LESSON)만 쓴다
  publicProfile Boolean  @default(false)
  coachIntro    String?  @db.Text
  coachCareer   String?
  /// lib/market/lessons.ts SPECIALTIES 의 key — pitching · hitting · youth · rehab …
  specialties   String[] @default([])
  /// 1회 기준 가격(원) · 가격 메모('10회권 40만') · 레슨 가능 시간('평일 저녁 · 주말 오전')
  priceFrom     Int?
  priceNote     String?
  lessonHours   String?
  /// 레슨 코치 찾기 3판(2026-10-22, 닥터나우식) — 모두 비워 둘 수 있다(더하기만).
  /// coachName: 코치 이름(비면 마스터 닉네임 — 더미 코치 · 대리 등록용). lessonSlots: 요일별 레슨 가능 시간(lib/market/venues.ts VenueHours 와 같은 JSON),
  /// slotMin: 한 레슨 길이(분). trialPrice: 첫 레슨 체험가(원). sinkerReview: 싱커 기록 · 영상을 보고 레슨한다. dummy: 관리자가 넣은 더미 코치(한 번에 지운다)
  coachName     String?
  lessonSlots   Json?
  slotMin       Int      @default(60)
  trialPrice    Int?
  sinkerReview  Boolean  @default(false)
  dummy         Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User            @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  OrgMember[]
  invites  OrgInvite[]
  events   OrgEvent[]
  notices  OrgNotice[]
  bookings LessonBooking[]
  reviews  LessonReview[]

  @@index([ownerId])
}

/// 조직의 구성원 — 마스터 · 스태프 · 선수(회원). userId 가 null 이면 코치가 대신 만든 자리(아직 가입 안 함)
model OrgMember {
  id       String          @id @default(uuid())
  orgId    String
  userId   String?
  role     OrgRole
  status   OrgMemberStatus @default(ACTIVE)
  /// 조직 안에서 부르는 이름 — 들어올 때 User.nickname 을 베끼고 스태프가 고칠 수 있다
  nickname String
  /// 포지션 · 학년 · 묶음 — 자유 글
  tags     String[]        @default([])
  memo     String?         @db.Text
  joinedAt DateTime        @default(now())
  leftAt   DateTime?

  org     Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user    User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  consent ShareConsent?
  notes   LessonNote[]
  passes  LessonPass[]
  reports GuardianReport[]

  @@unique([orgId, userId])
  @@index([orgId, status])
  @@index([userId])
}

/// 초대 코드 — 여섯 글자(0 · O · 1 · I 없음, lib/org/rules.ts). 선수 코드는 기한까지 여럿이 쓰고, 스태프 코드는 한 번
model OrgInvite {
  id        String    @id @default(uuid())
  orgId     String
  code      String    @unique
  role      OrgRole   @default(PLAYER)
  /// 코치가 대신 만든 자리(OrgMember.id)를 그 사람이 이어받게 하는 초대
  memberId  String?
  expiresAt DateTime
  usedById  String?
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

/// 선수가 조직에 보여 주는 범위 — 구성원마다 하나. 줄이 없으면(코치가 대신 만든 자리) 모두 보인다(lib/org/access.ts memberScope)
model ShareConsent {
  memberId  String   @id
  pitch     Boolean  @default(true)
  training  Boolean  @default(true)
  checkin   Boolean  @default(true)
  video     Boolean  @default(true)
  nutrition Boolean  @default(false)
  weight    Boolean  @default(false)
  /// 마지막으로 바꾼 사람(User.id)
  byUserId  String
  updatedAt DateTime @updatedAt

  member OrgMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

/// 조직 일정(팀 달력 · 레슨 시간표) — 선수 개인의 CalendarEvent 와 다른 표(결정 7, 2026-10-20)
model OrgEvent {
  id          String   @id @default(uuid())
  orgId       String
  date        DateTime @db.Date
  /// 'HH:MM' — 비우면 하루 종일
  time        String?
  /// 'training' 훈련 · 'game' 경기 · 'rest' 휴식 · 'lesson' 레슨 · 'other'
  kind        String
  title       String
  memo        String?  @db.Text
  /// 레슨 시간표 — 어느 회원의 레슨인가(OrgMember.id). 팀 일정은 비어 있다
  memberId    String?
  /// 지도 활동 확인(2026-10-26 2단계) — 'planned' 예정 · 'done' 실시 · 'canceled' 취소. 출석 · 수강권과 무관(차감은 덕아웃 예약 끝남)
  status      String    @default("planned")
  doneAt      DateTime?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, date])
  @@index([memberId])
}

/// 조직 공지 — 앱 전체 공지(SupportNotice)와 다른 표(결정 6, 2026-10-20)
model OrgNotice {
  id        String   @id @default(uuid())
  orgId     String
  title     String
  body      String   @db.Text
  pinned    Boolean  @default(false)
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, pinned, createdAt])
}

/// 레슨 노트(4단계) — 표는 1단계에 함께 만들어 마이그레이션을 한 번으로
model LessonNote {
  id        String   @id @default(uuid())
  memberId  String
  date      DateTime @db.Date
  body      String   @db.Text
  homework  String?  @db.Text
  /// 한 일(2026-10-21 개편 3단계) — [{ name, sets, reps, note }] (lib/org/lesson-work.ts parseExercises). 선수의 레슨 줄 · 트레이닝 엔진(김민 B-3)이 읽는다
  exercises Json?
  /// 레슨 중 던진 공 수 · 강도(1~10) — 2단계부터 저장할 때 선수 투구 기록(PitchLog, orgEventId 같음)으로도 남는다
  pitchCount Int?
  intensity  Int?
  authorId  String
  /// 어느 지도 활동의 일지인가(OrgEvent.id) — 저장할 때 활동이 없으면 그날 'done' 레슨 활동을 만들어 잇는다(2026-10-26 2단계)
  eventId    String?
  /// 일지에 붙인 영상(저장소 경로) — 코치가 찍었거나 선수 투구 영상에서 고른 것
  videoPaths String[] @default([])
  editedById String?
  createdAt DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  member OrgMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, date])
  @@index([eventId])
}

/// 숙제(2026-10-26 2단계) — 회원 한 명에 한 줄. 'done' 이면 실제 수행 기록(운동 판 · 투구 기록)을 가리킨다
model OrgAssignment {
  id             String    @id @default(uuid())
  orgId          String
  memberId       String
  /// 어느 일지에서 냈나(LessonNote.id)
  noteId         String?
  assignedById   String
  /// [{ exerciseId?, guideId?, sets?, reps?, holdSec?, note? }] — 라이브러리 운동 · 드릴만(자유 글 운동 없음)
  items          Json
  dueDate        DateTime? @db.Date
  /// 'assigned' 배정 · 'in_progress' 하는 중 · 'done' 완료 · 'excused' 면제 · 'canceled' 취소
  status         String    @default("assigned")
  doneSessionId  String?
  donePitchLogId String?
  doneAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([memberId, status])
  @@index([orgId, createdAt])
}

/// 일지 · 숙제에 다는 말(2026-10-26 2단계) — 코치의 영상 시점 코멘트 · 회원 질문 · 정정 요청 · 숙제 영상 제출을 한 표에.
/// 코치 '받은 것' = 회원이 쓴 줄 가운데 아직 안 푼 것(resolvedAt null)
model OrgComment {
  id           String    @id @default(uuid())
  orgId        String
  memberId     String
  noteId       String?
  assignmentId String?
  authorId     String
  /// 'comment' 말 · 'question' 질문 · 'fix' 정정 요청 · 'submit' 숙제 영상
  kind         String    @default("comment")
  body         String    @db.Text
  videoPath    String?
  /// 영상의 몇 초에 단 말인가
  atSec        Float?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([noteId])
  @@index([assignmentId])
  @@index([orgId, resolvedAt])
}

/// 일정 참석(2026-10-26 3단계, docs/designs/sinker-team-lesson-contract.md 4절) — 선수 응답과 코치가 확인한 실제 참석. 부하 · 수강권과 무관하다
model OrgEventAttendee {
  eventId   String
  memberId  String
  /// 'yes' 가요 · 'no' 못 가요 · 'maybe' 아직 몰라요 — 선수 응답(안 했으면 null)
  reply     String?
  /// 못 가는 까닭 같은 한 줄
  note      String?
  /// 코치가 확인한 실제 참석(안 했으면 null)
  attended  Boolean?
  updatedAt DateTime @updatedAt

  @@id([eventId, memberId])
  @@index([memberId])
}

/// 훈련 메뉴 — 한 일정에 묶음별로(예: 투수조 · 야수조). 배정할 때의 대상 명단을 남긴다(묶음이 나중에 바뀌어도 그대로).
/// 메뉴는 계획일 뿐 부하에 안 든다 — 끝나고 코치가 선수별로 한 것을 기록하면 그 선수의 그날 운동 판에 세트로 붙는다(lib/org/team-work-store.ts)
model OrgPlan {
  id          String   @id @default(uuid())
  orgId       String
  eventId     String
  title       String
  /// [{ exerciseId?, guideId?, sets?, reps?, holdSec?, note? }] — 라이브러리 운동 · 드릴만(숙제와 같은 모양, lib/org/homework.ts)
  items       Json
  /// 이 메뉴를 할 선수(OrgMember.id) — 비면 그 일정의 모두
  memberIds   String[] @default([])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventId])
  @@index([orgId])
}

/// 등판 계획 — 경기 일정 · 선수 하나에 한 줄. 'confirmed' 만 선수의 다음 등판으로 쓴다(엔진의 등판 짐작이 한 출처로 더 읽는다)
model OrgOuting {
  id          String   @id @default(uuid())
  orgId       String
  eventId     String
  memberId    String
  /// 'starter' 선발 · 'relief' 불펜 · 'standby' 대기
  role        String
  /// 투구 수 한도(없으면 null)
  pitchLimit  Int?
  /// 'draft' 짜는 중 · 'confirmed' 확정 · 'canceled' 취소
  status      String   @default("draft")
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([eventId, memberId])
  @@index([memberId, status])
  @@index([orgId])
}

/// 공지 읽음 — 선수가 공지를 연 때(코치는 몇 명이 읽었나를 본다)
model OrgNoticeRead {
  noticeId String
  memberId String
  readAt   DateTime @default(now())

  @@id([noticeId, memberId])
  @@index([memberId])
}

/// 수강권(4단계) — 회원마다 '총 N회 · 쓴 M회 · 기한'. 레슨 노트를 레슨 날에 쓰면 한 회 줄고, 3회 남으면 홈이 알린다(lib/org/rules.ts passLeft)
model LessonPass {
  id        String    @id @default(uuid())
  memberId  String
  total     Int
  used      Int       @default(0)
  expiresAt DateTime? @db.Date
  memo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  member OrgMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

/// 보호자 리포트 링크(4단계) — 토큰 주소 + 네 자리 코드(bcrypt 해시), 30일. 주소에 사람 정보는 없다(app/(report)/report/[token])
model GuardianReport {
  id           String    @id @default(uuid())
  token        String    @unique
  memberId     String
  codeHash     String
  expiresAt    DateTime
  createdById  String
  lastOpenedAt DateTime?
  createdAt    DateTime  @default(now())

  member OrgMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

/*
 * ─────────────────────────── 덕아웃 장터(2026-10-20, docs/designs/baseball-hub.md 1판) ───────────────────────────
 * 중고 야구용품 — 물건(Listing) · 찜 · 채팅(Conversation · Message). 로그인 없이 보고, 올리기 · 찜 · 채팅만 로그인.
 * 규격(specs)은 품목마다 다른 칸을 JSON 으로(lib/market/specs.ts 가 정한다). 사진은 투구 영상과 같은 비공개 저장소(서명 주소).
 */

/// 장터 물건 하나
model Listing {
  id        String    @id @default(uuid())
  userId    String
  /// lib/market/specs.ts CATEGORIES 의 key — glove · bat · spikes · protector · uniform · ball · bag · training · other
  category  String
  title     String
  /// 원 단위. 0 = 나눔
  price     Int
  body      String    @db.Text
  /// 'new' · 'like-new' · 'used' · 'worn'(lib/market/specs.ts CONDITIONS)
  condition String
  /// 품목별 규격 — 글러브: hand · position · inch, 배트: lengthCm · weightG · material …
  specs     Json      @default("{}")
  /// 시 · 도(lib/market/specs.ts REGIONS) — 전국 서비스이되 직거래는 지역으로 거른다
  region    String
  /// 저장소 경로(사용자 폴더 안) — 다섯 장까지, 첫 장이 대표
  images    String[]  @default([])
  /// 'ACTIVE' 판매 중 · 'RESERVED' 예약 중 · 'SOLD' 거래 완료
  status    String    @default("ACTIVE")
  views     Int       @default(0)
  /// 관리자가 가림(신고 처리) — 목록 · 검색에서 빠지고 주인과 관리자만 본다
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites ListingFavorite[]
  chats     Conversation[]
  reports   CommunityReport[]

  @@index([status, hiddenAt, createdAt])
  @@index([category, status, createdAt])
  @@index([userId])
}

/// 찜
model ListingFavorite {
  listingId String
  userId    String
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([listingId, userId])
  @@index([userId])
}

/// 채팅방 — 물건 하나에 사는 사람 하나. 물건이 지워져도 대화는 남는다(SetNull)
model Conversation {
  id        String    @id @default(uuid())
  listingId String?
  buyerId   String
  sellerId  String
  /// 마지막 말 — 목록 한 줄
  lastText  String?
  lastAt    DateTime  @default(now())
  /// 마지막으로 읽은 때 — 안 읽은 수는 이 뒤의 상대 말을 센다
  buyerReadAt  DateTime?
  sellerReadAt DateTime?
  createdAt DateTime  @default(now())

  listing  Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  buyer    User      @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User      @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([listingId, buyerId])
  @@index([buyerId, lastAt])
  @@index([sellerId, lastAt])
}

/// 채팅 한 줄
model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  body           String   @db.Text
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

/*
 * ─────────────────────────── 덕아웃 레슨 예약(2판) · 장소 예약(3판) — 2026-10-21 ───────────────────────────
 * 레슨 예약은 코치(레슨장 마스터)의 공개 프로필(Org.publicProfile)에 선수가 날짜 · 시간 둘을 골라 요청 → 코치가 하나를 확정. 확정되면 그 레슨장의
 * 회원이 되고(OrgMember) 레슨 시간표(OrgEvent lesson)에 들어간다. 후기는 끝난(DONE) 예약에만. 장소는 마스터 계정이 등록하고(Venue), 시간표에서
 * 빈 칸을 골라 예약(VenueBooking) — 사장님이 승인하거나 즉시 확정.
 */

/// 레슨 예약 요청 한 건
model LessonBooking {
  id        String    @id @default(uuid())
  orgId     String
  userId    String
  /// 확정되며 만든(또는 이미 있던) 회원 줄
  memberId  String?
  /// 'REQUESTED' 요청 · 'CONFIRMED' 확정 · 'DECLINED' 거절 · 'CANCELED' 취소(선수) · 'DONE' 끝남
  status    String    @default("REQUESTED")
  /// 원하는 때 둘 — 코치가 하나를 고른다(chosen)
  slot1     DateTime
  slot2     DateTime?
  chosen    DateTime?
  /// 선수가 적은 말 · 코치의 답
  note      String?   @db.Text
  reply     String?   @db.Text
  /// 확정될 때 만든 시간표 줄(OrgEvent.id)
  eventId   String?
  /// 3판(2026-10-22) — 무엇을(lib/market/lessons.ts SPECIALTIES) · 누가 받나(AUDIENCES) · 결제 수단(PAY_METHODS, 저장만 — 결제는 아직) · 확정한 때(확정 속도 셈)
  specialty   String?
  audience    String?
  payMethod   String?
  confirmedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  org    Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  review LessonReview?

  @@index([orgId, status, slot1])
  @@index([userId, createdAt])
}

/// 레슨 후기 — 끝난 예약 하나에 하나(실제 수강생만)
model LessonReview {
  id        String   @id @default(uuid())
  orgId     String
  userId    String
  bookingId String   @unique
  /// 1~5
  rating    Int
  body      String   @db.Text
  /// 좋았던 점 칩(lib/market/lessons.ts REVIEW_TAGS 의 key, 3판)
  tags      String[] @default([])
  createdAt DateTime @default(now())

  org     Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking LessonBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

/// 연습장 · 구장 하나 — 마스터 계정(레슨장 · 팀)이 등록한다
model Venue {
  id        String   @id @default(uuid())
  ownerId   String
  name      String
  /// 'indoor' 실내 연습장 · 'field' 야외 구장 · 'cage' 타격 케이지 · 'machine' 피칭 머신 · 'other'
  kind      String
  region    String
  address   String?
  /// 지도 자리 — 주소를 저장할 때 카카오 주소 검색으로 채운다(lib/geocode.ts). 못 찾으면 null
  lat       Float?
  lng       Float?
  intro     String?  @db.Text
  /// 한 칸(분) 30 · 60 · 120, 칸당 가격(원), 가격 메모
  slotMin   Int      @default(60)
  pricePerSlot Int?
  priceNote String?
  /// 요일별 영업시간 — lib/market/venues.ts VenueHours(일~토, 'HH:MM'~'HH:MM' 또는 null=쉼)
  hours     Json     @default("{}")
  /// true 면 사장님이 승인해야 확정, false 면 즉시 확정
  approval  Boolean  @default(true)
  images    String[] @default([])
  publicProfile Boolean @default(true)
  hiddenAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookings VenueBooking[]

  @@index([ownerId])
  @@index([region, kind, publicProfile])
}

/// 장소 예약 한 건 — 그날 몇 분부터 몇 분까지(자정 기준 분)
model VenueBooking {
  id        String   @id @default(uuid())
  venueId   String
  userId    String
  date      DateTime @db.Date
  startMin  Int
  endMin    Int
  /// 'REQUESTED' · 'CONFIRMED' · 'DECLINED' · 'CANCELED'
  status    String   @default("REQUESTED")
  note      String?  @db.Text
  reply     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([venueId, date, status])
  @@index([userId, date])
}

/// 앱 알림 기기(2026-10-21 개편 5단계, docs/designs/sinker-dugout.md 8절 D) — Expo 푸시 토큰. app 은 'sinker' · 'dugout'(어느 앱이 등록했나), 보낼 곳 규칙은 lib/notify-rules.ts
model PushDevice {
  id         String   @id @default(uuid())
  userId     String
  app        String
  platform   String   @default("ios")
  token      String   @unique
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

/// 알림 기록(5단계) — 웹 알림함(/notifications) · 위 막대 숫자. kind: chat · booking · venue · lesson · listing · community · team
model Notification {
  id        String    @id @default(uuid())
  userId    String
  kind      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// 코드 · QR 로그인(2026-10-21 개편 7단계 7-3, docs/designs/sinker-dugout.md 8절 E) — PC 가 코드를 만들고(/login/qr), 로그인된 폰(싱커 앱 · 웹)이 /link/<code> 에서 승인하면 PC 가 세션을 받는다. 2분, 한 번
model LoginTicket {
  code      String    @id
  userId    String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  claimedAt DateTime?

  @@index([expiresAt])
}

/// 덕아웃 경기 댓글(2026-10-24 금윤호: "경기를 선택했을 때 기록을 보고 댓글을 달 수 있게") — 경기는 우리 표가 아니라 네이버 경기 번호(gameId)로 잇는다.
model GameComment {
  id        String    @id @default(uuid())
  gameId    String
  userId    String
  body      String    @db.Text
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gameId, createdAt])
  @@index([userId])
}

/// 덕아웃 레슨 · 연습장 수집 후보(2026-10-26, 대표관리자만) — 공공자료(소상공인 상가정보) · 지도 대조로 모은 미확인 후보.
/// 예약용 Org · Venue · 예약 · 후기와 따로 둔다(업체가 동의하지 않았다). 공개 목록 · 검색 · 지도는 이 표를 읽지 않는다(npm run dugout:test 가 지킨다).
/// 수집 칸은 다시 가져오면 바뀌고(scripts/import-facility-candidates.mts — 자료의 candidates 배열만), 연락 · 동의 · 확인 · 승인 · 메모 칸은
/// 관리자 화면만 쓴다(가져오기가 덮지 않는다). 공개는 업체 동의 · 정보 확인 · 관리자 승인 뒤 — 공개 레슨장 · 연습장으로 옮기는 길은 아직 없다.
model FacilityCandidate {
  /// 수집 자료의 id 그대로('semas:<업소번호>' · 'naver:<장소번호>') — 다시 가져올 때 같은 곳을 알아본다. 이미 있는 행의 기본키는 바꾸지 않는다
  /// (통합 자료 2026-10-26 은 이전 id 를 sourceCandidateIds 로 이어 준다 — lib/market/candidates.ts planImport)
  id               String    @id
  name             String
  /// 수집 자료의 분류 단서('레슨·훈련 후보' · '배팅·연습공간 후보' …) — 서비스 확정값 아님
  typeHint         String
  region           String
  district         String?
  roadAddress      String?
  address          String?
  /// 수집 좌표(공공자료 건물 위치) — 없으면 지도 핀 없이 목록에만. 관리자가 손으로 고치면 coordsEdited 가 켜져 다시 가져와도 그대로
  lat              Float?
  lng              Float?
  coordsEdited     Boolean   @default(false)
  /// 관리자가 좌표를 정한 근거 · 날짜('MANUAL' 손으로 · 'KAKAO_GEOCODE' 주소 찾기) — 수집 좌표(건물 참조)는 비어 있다
  coordsSource     String?
  coordsSetAt      DateTime?
  /// 지도 대조 · 공개 안내 근거 수준(lib/market/candidates.ts) — 확정값이 아니다
  mapStatus        String?
  lessonNotice     String?
  rentalNotice     String?
  hardballNotice   String?
  /// 영업 공개 근거(최근 소식 · 시간표 · 근거 부족) — 실제 영업 확인 아님
  operationNotice  String?
  /// 수집 묶음('ORIGINAL_178' 처음 정리 · 'ADDITIONAL_256' 추가 발견)
  originGroup      String?
  /// 확인 우선 꼬리표 — 수집 자료의 reviewPriorityTags + 가져오기가 찾은 충돌(업체 확인값 ↔ 공개 근거 등). 다시 가져올 때마다 다시 만든다
  reviewTags       String[]  @default([])
  /// 같은 지도 장소를 쓰는 기록 · 근거리 유사 상호 묶음 — 자동 병합하지 않고 검토 표시만
  sharedPlaceGroup String?
  duplicateGroup   String?
  /// 통합 자료가 같은 장소(같은 지도 장소 id · 주소)로 묶은 이전 기록 — 지우지 않고 이 id(대표 기록)로 이어 둔다. 목록 · 지도 · 수에서 빠진다
  mergedIntoId     String?
  /// 수집 자료 한 줄 통째(원본 행 · 출처 · 지도 대조 · 배팅 검토 · 플래그) — 원본 근거 보존
  collected        Json
  collectedAt      DateTime  @db.Date
  /// 다시 가져오며 바뀌기 전의 collected 들(가져온 날 · 자료 묶음과 함께) — 원본 근거를 잃지 않게
  collectedHistory Json      @default("[]")
  /// 아래는 관리자 칸 — 가져오기가 덮지 않는다. 값은 lib/market/candidates.ts
  collectionStatus String    @default("UNVERIFIED")
  businessStatus   String    @default("UNKNOWN")
  contactStatus    String    @default("NOT_CONTACTED")
  consentStatus    String    @default("NOT_REQUESTED")
  /// 업체에 확인한 서비스 — null 은 아직 모름(공개 안내 · 사진 · 지도만으로 바꾸지 않는다)
  offersLessons    Boolean?
  offersRental     Boolean?
  offersHardball   Boolean?
  /// 업체 연락처 · 동의 범위(무엇을 공개해도 되는지) — 업체에 직접 받은 것만
  phone            String?
  consentScope     String?   @db.Text
  verifiedAt       DateTime?
  lastContactedAt  DateTime?
  adminNote        String?   @db.Text
  /// 관리자 승인 — 동의(AGREED) · 정보 확인(VERIFIED) 뒤에만. 승인한 관리자 id(관계 없이)
  approvedAt       DateTime?
  approvedById     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([region])
  @@index([mergedIntoId])
}
