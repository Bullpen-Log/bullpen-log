datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}
generator client {
  provider = "prisma-client-js"
}


enum Role {
  USER
  ADMIN
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  password          String
  nickname          String
  role              Role                @default(USER)
  /// 생년월일. 나이에 따라 안전한 투구수 한도가 달라져 투구량 조언에 필요하다.
  birthDate         DateTime?           @db.Date
  /// 키(cm). 영상에서 잰 길이를 몸 크기로 나눠 비교할 때 쓴다.
  heightCm          Int?
  createdAt         DateTime            @default(now())

  userGuideProgress UserGuideProgress[]
  pitchLogs         PitchLog[]
  userExerciseLogs  UserExerciseLog[]
  routines          Routine[]
  articles          Article[]
}

model MechanicsGuide {
  id          String              @id @default(uuid())
  title       String
  category    String              @default("스로잉 드릴")
  description String              @db.Text
  videoUrl    String
  /// 이 드릴이 무엇을 교정하는지. 영상분석 결과와 이어지는 고리다.
  focusPoints String[]
  /// 드릴에 필요한 도구
  equipment   String[]
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  progress    UserGuideProgress[]
}

model UserGuideProgress {
  userId    String
  guideId   String
  completed Boolean        @default(false)

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  guide     MechanicsGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@id([userId, guideId])
}

model PitchLog {
  id          String   @id @default(uuid())
  userId      String
  date        DateTime @db.Date
  pitchCount  Int
  intensity   Int
  maxVelocity Float
  avgVelocity Float?
  memo        String?  @db.Text
  /// 그날 던진 영상의 저장소 경로. 최대 2개까지 저장한다.
  videoPaths  String[]
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExerciseVideo {
  id               String            @id @default(uuid())
  title            String
  category         String
  description      String            @db.Text
  videoUrl         String
  /// 이 운동이 목표로 하는 부위
  bodyParts        String[]
  /// 낮음 / 중간 / 높음. 부하 지수가 높을 때 '높음'을 빼는 데 쓴다.
  intensity        String            @default("중간")
  /// 초급 / 중급 / 상급. 선택 입력이라 비어 있을 수 있다.
  difficulty       String?
  /// 운동에 필요한 도구
  equipment        String[]
  createdAt        DateTime          @default(now())
  userLogs         UserExerciseLog[]
  routineExercises RoutineExercise[]
}

model UserExerciseLog {
  userId     String
  exerciseId String
  date       DateTime      @db.Date
  completed  Boolean       @default(false)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   ExerciseVideo @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([userId, exerciseId, date])
}

model Routine {
  id               String            @id @default(uuid())
  userId           String
  name             String
  createdAt        DateTime          @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineExercises RoutineExercise[]
}

model RoutineExercise {
  routineId  String
  exerciseId String

  routine    Routine       @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise   ExerciseVideo @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([routineId, exerciseId])
}

model Article {
  id            String   @id @default(uuid())
  userId        String
  title         String
  content       String   @db.Text
  tags          String[]
  attachmentUrl String?
  views         Int      @default(0)
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
