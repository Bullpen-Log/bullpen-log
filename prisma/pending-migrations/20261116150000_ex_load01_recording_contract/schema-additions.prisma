model WorkoutLoadRecovery {
  id              String   @id
  ownerId         String
  actorId         String
  setId           String
  sessionId       String
  exerciseId      String
  setNo           Int
  clientSetId     String?
  originalHash    String
  originalPayload Json
  /// LEGACY_UNSUPPORTED_LOAD · LEGACY_INVALID_LOAD · ORG_UNSUPPORTED_LOAD
  reason          String
  protocol        Int?
  /// open | resolved | discarded — 저절로 지우지 않는다
  state           String   @default("open")
  createdAt       DateTime @default(now())

  @@unique([ownerId, sessionId, exerciseId, setNo, originalHash], map: "WorkoutLoadRecovery_owner_set_hash_key")
  @@index([ownerId, state])
  @@index([setId])
}
